@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Recover account";
    ViewData["FigmaFrame"] = "15_20";
    ViewData["StatusMessage"] = "ACCOUNT RECOVERY  •  STEP 1 OF 3";
}
<section class="auth-card compact" aria-labelledby="account-title">
    <header><p class="auth-step">01 / Verify account</p><h1 id="account-title">Verify your campus account.</h1><p class="auth-description">Use the email address associated with your account.</p></header>
    <hr class="auth-divider" />
    @await Html.PartialAsync("_AccountFeedback")
    <form class="auth-form" action="/auth/password-reset-request" method="post">
        @Html.AntiForgeryToken()
        <label class="auth-field" for="Email"><span class="auth-field-label">Email address</span>
            <input class="auth-input" id="Email" name="Email" type="email" value="@(ViewData["Email"] as string)" placeholder="name@example.com" autocomplete="email" required />
            @Html.ValidationMessage("Email", null, new { @class = "auth-field-error" })
            <span class="auth-field-help">Enter the account identifier we should verify.</span>
        </label>
        <button class="auth-action" type="submit">SEND VERIFICATION CODE</button>
    </form>
    <div class="auth-spacer"></div>
    <div class="auth-panel"><img src="/figma/assets/bb17f.svg" alt="" /><div><strong>Account check</strong><span>The code confirms the account before password changes are allowed.</span></div></div>
    <div class="auth-actions"><a class="auth-secondary" href="/auth/login">← BACK TO SIGN IN</a></div>
    <div class="auth-spacer"></div>
    @await Html.PartialAsync("_AccountStatus")
</section>
