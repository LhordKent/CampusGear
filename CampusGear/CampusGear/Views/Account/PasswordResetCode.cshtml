@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Verify recovery code";
    ViewData["FigmaFrame"] = ViewData["ErrorMessage"] is string || ViewData.ModelState.ErrorCount > 0 ? "405_2" : "15_30";
    ViewData["StatusMessage"] = "ACCOUNT RECOVERY  •  STEP 2 OF 3";
}
<section class="auth-card compact" aria-labelledby="account-title">
    <header><p class="auth-step">02 / Verify code</p><h1 id="account-title">Verify the one-time code</h1><p class="auth-description">We sent a six-digit code to your registered email address.</p></header>
    <hr class="auth-divider" />
    @await Html.PartialAsync("_AccountFeedback")
    <div class="auth-summary"><strong>Code sent</strong><p>@(ViewData["MaskedEmail"] as string ?? "Check your inbox for the newest message")</p></div>
    <form class="auth-form" action="/auth/password-reset-code" method="post">
        @Html.AntiForgeryToken()
        <label class="auth-field" for="Code"><span class="auth-field-label">Verification code</span>
            <input class="auth-input auth-code" id="Code" name="Code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••" required />
            @Html.ValidationMessage("Code", null, new { @class = "auth-field-error" })
            <span class="auth-field-help">Enter the 6-digit code from your email.</span>
        </label>
        <button class="auth-action" type="submit">VERIFY CODE</button>
    </form>
    <div class="auth-actions">
        <form class="auth-inline-form" action="/auth/resend-password-reset-code" method="post">@Html.AntiForgeryToken()<button type="submit">Resend code</button></form>
        <a class="auth-link" href="/auth/password-reset-request">Use a different email address</a>
    </div>
    <div class="auth-spacer"></div>
    <div class="auth-panel"><img src="/figma/assets/bb17f.svg" alt="" /><div><strong>Code guidance</strong><span>Use the newest code. Older codes may expire after another request.</span></div></div>
    <div class="auth-spacer"></div>
    @await Html.PartialAsync("_AccountStatus")
</section>
