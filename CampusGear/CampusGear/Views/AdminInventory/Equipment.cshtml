@using CampusGear.Models
@model InventoryPageModel
@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "Equipment Management";
    ViewData["WorkspaceRole"] = "Administrator";
}
<main class="live-content" data-figma-source="695:5691">
    <header class="live-heading"><p class="live-eyebrow">ADMINISTRATOR • INVENTORY</p><h1>Equipment Management</h1><p>Track individual items, their condition, and borrowing availability.</p></header>
    @if (Model.Feedback is not null) { <div class="live-feedback" role="status">@Model.Feedback</div> }
    <section class="live-panel" aria-labelledby="inventory-title">
        <h2 id="inventory-title">Equipment inventory <span class="live-badge">@Model.Total items</span></h2>
        <form method="get" class="live-filters"><label>Search name or asset code<input name="q" value="@Model.Query" /></label><button class="live-button" type="submit">Search</button><a class="live-button secondary" href="/admin/equipment">Reset / add new</a></form>
        <div class="live-table-wrap"><table class="live-table"><thead><tr><th>Equipment</th><th>Category</th><th>Condition</th><th>Availability</th><th>Action</th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td>@item.Name<small>@item.AssetCode · @item.Location</small></td><td>@item.Category.Name</td><td>@item.Condition</td><td><span class="live-badge">@(!item.IsActive ? "Inactive" : item.IsMaintenanceHold ? "Maintenance hold" : "Active")</span></td><td><a class="live-link" href="/admin/equipment?id=@item.Id">Edit</a></td></tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="5">No equipment matches this search.</td></tr> }
        </tbody></table></div>
        <nav class="live-pager" aria-label="Inventory pages">
            @if (Model.Page > 1) { <a class="live-link" href="/admin/equipment?q=@Uri.EscapeDataString(Model.Query)&amp;page=@(Model.Page - 1)">Previous</a> }
            <span>Page @Model.Page of @Model.Pages</span>
            @if (Model.Page < Model.Pages) { <a class="live-link" href="/admin/equipment?q=@Uri.EscapeDataString(Model.Query)&amp;page=@(Model.Page + 1)">Next</a> }
        </nav>
    </section>
    <section class="live-panel" aria-labelledby="edit-title">
        <h2 id="edit-title">@(Model.Input.Id is null ? "Add equipment" : "Edit equipment")</h2>
        <div asp-validation-summary="All"></div>
        <form method="post" action="/admin/equipment/save" class="live-form">
            @Html.AntiForgeryToken()
            <input asp-for="Input.Id" type="hidden" /><input asp-for="Input.RowVersion" type="hidden" />
            <label class="live-field">Asset code<input asp-for="Input.AssetCode" required maxlength="64" /></label>
            <label class="live-field">Equipment name<input asp-for="Input.Name" required maxlength="160" /></label>
            <label class="live-field">Category<select asp-for="Input.CategoryId">@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select></label>
            <label class="live-field">Condition<select asp-for="Input.Condition" asp-items="Html.GetEnumSelectList<EquipmentCondition>()"></select></label>
            <label class="live-field">Serial number<input asp-for="Input.SerialNumber" maxlength="120" /></label>
            <label class="live-field">Storage location<input asp-for="Input.Location" maxlength="160" /></label>
            <label class="live-field wide">Description<textarea asp-for="Input.Description" maxlength="2000"></textarea></label>
            <label class="live-check wide"><input asp-for="Input.IsActive" /> Active inventory item</label>
            <p class="live-muted wide">Damaged or unserviceable items enter maintenance. Close their maintenance case after repair to restore availability. Equipment with an active loan cannot be edited.</p>
            <div class="live-actions wide"><button class="live-button" type="submit">Save equipment</button><a class="live-button secondary" href="/admin/equipment">Clear form</a></div>
        </form>
    </section>
    <section class="live-panel"><details><summary>Add a category</summary><form method="post" action="/admin/categories" class="live-filters">@Html.AntiForgeryToken()<label>Category name<input name="name" required maxlength="120" /></label><button class="live-button" type="submit">Add category</button></form></details></section>
</main>
