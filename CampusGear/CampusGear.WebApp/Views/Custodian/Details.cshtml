@model CustodianDetailViewModel
@using CampusGear.Models
@{
    Layout = "_WorkspaceLayout";
    var record = Model.Record;
    var loan = record.Loan;
    var route = $"/custodian/reservations/{record.Id}";
    var admin = ViewData["WorkspaceRole"] as string == "Administrator";
    var staffPath = admin ? "/admin" : "/custodian";
    var returning = Model.CanReturn || record.Status == ReservationStatus.Completed;
    ViewData["Title"] = returning ? "Return & Condition Check" : "Approval & Release";
    var source = returning ? admin ? "695:3957" : "695:2032" : admin ? "695:3278" : "695:1499";
}
@section Styles { <link rel="stylesheet" href="~/css/custodian-workflows.css" asp-append-version="true" /> }
<main class="live-content" data-figma-source="@source">
    <header class="live-heading"><p class="live-eyebrow">@(admin ? "ADMINISTRATOR" : "CUSTODIAN") • EQUIPMENT WORKFLOW</p><h1>@ViewData["Title"]</h1><p>@(returning ? "Record equipment returns and update item condition." : "Review reservation requests and record equipment release.")</p></header>
    @if (!string.IsNullOrWhiteSpace(Model.Feedback)) { <div class="live-feedback" role="status">@Model.Feedback</div> }
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="live-feedback error" role="alert">@Model.Error</div> }
    @if (!string.IsNullOrWhiteSpace(Model.AvailabilityNote)) { <div class="live-feedback" role="status">@Model.AvailabilityNote</div> }
    <section class="live-panel live-decision" aria-labelledby="request-title">
        <div class="live-toolbar"><h2 id="request-title">@(returning ? "RETURN & CONDITION CHECK" : "REQUEST DECISION")</h2><span class="live-badge">@Model.Status</span></div>
        <div class="live-request-fields">
            <div class="live-request-field"><small>BORROWER</small><strong>@record.BorrowerProfile.User.FullName</strong><p class="live-muted">@record.BorrowerProfile.User.Email<br />@(record.BorrowerProfile.ContactNumber ?? "No contact number recorded")</p></div>
            <div class="live-request-field"><small>EQUIPMENT</small><strong>@record.EquipmentItem.Name</strong><p class="live-muted">@record.EquipmentItem.AssetCode · @record.EquipmentItem.Category.Name<br />@record.EquipmentItem.Condition · @(record.EquipmentItem.Location ?? "No location recorded")</p></div>
            <div class="live-request-field"><small>REQUESTED DATE &amp; TIME</small><strong>@CustodianTime.Format(record.StartAtUtc)</strong><p class="live-muted">Until @CustodianTime.Format(record.EndAtUtc)<br />Manila time (UTC+8)</p></div>
        </div>
        <div class="live-request-field"><small>PURPOSE</small><strong class="custodian-preserve">@record.Purpose</strong><p class="live-muted custodian-preserve">@(record.Notes ?? "No additional notes")</p></div>
        @if (Model.CanApprove || Model.CanReject)
        {
            <div class="live-decision-actions"><a class="live-button secondary" href="@staffPath/approvals">Back to requests</a>
                <details class="live-reject"><summary class="live-button danger">Reject request</summary><form class="live-form" method="post" action="@route/reject">@Html.AntiForgeryToken()<label class="live-field wide" for="Reason">Rejection reason<textarea id="Reason" name="Reason" maxlength="1000" required placeholder="Explain why this request cannot proceed"></textarea></label><button class="live-button danger wide" type="submit">Confirm rejection</button></form></details>
                <form method="post" action="@route/approve">@Html.AntiForgeryToken()<button class="live-button" type="submit" disabled="@(!Model.CanApprove)">Approve request</button></form>
            </div>
        }
        @if (record.Status == ReservationStatus.Approved)
        {
            <form class="live-form live-release-form" method="post" action="@route/release">@Html.AntiForgeryToken()<label class="live-field" for="ReleaseCondition">Condition at release<select id="ReleaseCondition" name="Condition" required disabled="@(!Model.CanRelease)">@foreach (var condition in new[] { EquipmentCondition.Excellent, EquipmentCondition.Good, EquipmentCondition.Fair }) { <option value="@condition" selected="@(record.EquipmentItem.Condition == condition)">@condition</option> }</select></label><label class="live-field" for="ReleaseNotes">Release notes (optional)<textarea id="ReleaseNotes" name="Notes" maxlength="2000" disabled="@(!Model.CanRelease)"></textarea></label><div class="live-actions wide"><a class="live-button secondary" href="@staffPath/returns?queue=release">Back to release queue</a><button class="live-button" type="submit" disabled="@(!Model.CanRelease)">Record release</button></div></form>
        }
        @if (Model.CanReturn)
        {
            <form class="live-form live-release-form" method="post" action="@route/return">@Html.AntiForgeryToken()<label class="live-field" for="ReturnCondition">Condition at return<select id="ReturnCondition" name="Condition" required>@foreach (var condition in Enum.GetValues<EquipmentCondition>()) { <option value="@condition" selected="@(condition == EquipmentCondition.Good)">@condition</option> }</select></label><label class="live-field" for="ReturnNotes">Return notes (optional)<textarea id="ReturnNotes" name="Notes" maxlength="2000" placeholder="Record inspection findings or damage"></textarea></label><div class="live-actions wide"><a class="live-button secondary" href="@staffPath/returns">Back to return queue</a><button class="live-button" type="submit">Record return</button></div></form>
        }
        @if (!Model.CanReturn && record.Status != ReservationStatus.Approved && !Model.CanApprove && !Model.CanReject)
        { <div class="live-actions"><a class="live-button secondary" href="@staffPath/history">View borrowing history</a></div> }
    </section>
    <div class="live-grid live-record-footer">
        <section class="live-panel"><h2>@(returning ? "Condition result" : "Request snapshot")</h2><dl class="live-details">
            <dt>Submitted</dt><dd>@CustodianTime.Format(record.CreatedAtUtc)</dd>
            @if (record.HoldExpiresAtUtc is { } expiry) { <dt>Pending hold expires</dt><dd>@CustodianTime.Format(expiry)</dd> }
            @if (record.DecidedAtUtc is { } decided) { <dt>Decision recorded</dt><dd>@CustodianTime.Format(decided) by @(record.DecidedByUser?.FullName ?? "staff")</dd> }
            @if (record.DecisionReason is { } reason) { <dt>Decision reason</dt><dd class="custodian-preserve">@reason</dd> }
            @if (loan is not null) {
                <dt>Released</dt><dd>@CustodianTime.Format(loan.ReleasedAtUtc) by @loan.ReleasedByUser.FullName</dd><dt>Release condition</dt><dd>@loan.ConditionAtRelease</dd><dt>Release notes</dt><dd class="custodian-preserve">@(loan.ReleaseNotes ?? "—")</dd>
                @if (loan.ReturnedAtUtc is { } returned) { <dt>Returned</dt><dd>@CustodianTime.Format(returned) by @(loan.ReceivedByUser?.FullName ?? "staff")</dd><dt>Return condition</dt><dd>@loan.ConditionAtReturn</dd><dt>Timeliness</dt><dd>@(returned > loan.DueAtUtc ? "Returned late" : "Returned on time")</dd><dt>Return notes</dt><dd class="custodian-preserve">@(loan.ReturnNotes ?? "—")</dd> }
            }
        </dl></section>
        <section class="live-panel"><h2>Next step</h2><p class="live-muted">@(returning ? "Inspect the returned equipment before recording its condition. Damaged or unserviceable items enter maintenance; late returns are recorded independently." : record.Status == ReservationStatus.Approved ? "Inspect the item and record its condition at handoff. Release is available during the approved booking time." : "Check the borrower, purpose, and requested time. Approval checks availability again; rejection releases the pending hold.")</p><div class="live-actions"><a class="live-button secondary" href="@staffPath/calendar">Availability calendar</a><a class="live-button secondary" href="@staffPath/history">Borrowing history</a></div></section>
    </div>
</main>