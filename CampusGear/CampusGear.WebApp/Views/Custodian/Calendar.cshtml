@model CustodianCalendarViewModel
@using System.Globalization
@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "Availability Calendar";
    var previous = Model.Month.AddMonths(-1);
    var next = Model.Month.AddMonths(1);
    var staffPath = ViewData["WorkspaceRole"] as string == "Administrator" ? "/admin" : "/custodian";
    var calendarAction = staffPath == "/admin" ? "AdminCalendar" : "Calendar";
}
@section Styles { <link rel="stylesheet" href="~/css/custodian-workflows.css" asp-append-version="true" /> }
<main class="live-content" data-figma-source="@(staffPath == "/admin" ? "695:4296" : "695:2691")">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">Records</p>
            <h1>Availability Calendar</h1>
            <p class="page-description">Choose a unit to see its bookings for the month, then pick a day for the details. Times are shown in Manila time (UTC+8).</p>
        </div>
        <div class="page-header-actions">
            <a class="live-button secondary" href="@staffPath/history">Borrowing history</a>
        </div>
    </header>
    <div class="calendar-with-picker" data-calendar>
        <partial name="_EquipmentPicker" model='new CampusGear.Models.EquipmentPickerModel(Model.Picker, Model.SelectedItem?.Id, staffPath + "/calendar", Model.Month.Year, Model.Month.Month)' />
        <div class="calendar-main">
        <section class="live-panel">
            <form class="calendar-selection" method="get" action="@staffPath/calendar" data-calendar-form>
                <input type="hidden" name="year" value="@Model.Month.Year" /><input type="hidden" name="month" value="@Model.Month.Month" />
                <input type="hidden" name="equipmentItemId" value="@Model.SelectedItem?.Id" />
                <div class="calendar-selected" data-calendar-region="selected">
                    <p class="page-eyebrow">Showing</p>
                    <strong>@Model.SelectedItem?.Name</strong> <span class="live-muted">@Model.SelectedItem?.AssetCode</span>
                </div>
                <span class="calendar-status" role="status" aria-live="polite" data-calendar-status hidden></span>
            </form>
            <div data-calendar-region="month">
                @if (Model.SelectedItem is null)
                { <div class="live-empty">No active equipment is available to display.</div> }
                else
                {
                    <nav class="custodian-calendar-nav" aria-label="Calendar months"><a class="live-button secondary" href="@ScreenUrls.Query(staffPath + "/calendar", new { year = previous.Year, month = previous.Month, equipmentItemId = Model.SelectedItem.Id })" aria-label="Previous month" data-calendar-link>←</a><h2>@Model.Month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</h2><a class="live-button secondary" href="@ScreenUrls.Query(staffPath + "/calendar", new { year = next.Year, month = next.Month, equipmentItemId = Model.SelectedItem.Id })" aria-label="Next month" data-calendar-link>→</a></nav>
                    @if (Model.SelectedItem.MaintenanceHold) { <div class="live-feedback warning" role="note">@Model.SelectedItem.Name is on a maintenance hold and can't be reserved or released.</div> }
                    <div class="custodian-calendar" aria-label="Equipment availability days">
                        @foreach (var weekday in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" }) { <div class="custodian-weekday">@weekday</div> }
                        @foreach (var day in Model.Days)
                        {
                            <a class="custodian-calendar-day @(!day.CurrentMonth ? "outside" : "") @(day.Selected ? "selected" : "") @(day.Today ? "today" : "") @(day.Status == "Maintenance" ? "maintenance" : day.BookingCount > 0 ? "reserved" : "available")" href="@ScreenUrls.Query(staffPath + "/calendar", new { year = Model.Month.Year, month = Model.Month.Month, equipmentItemId = Model.SelectedItem.Id, day = day.Date.ToString("yyyy-MM-dd") })" aria-current="@(day.Selected ? "date" : null)" aria-label="@day.Date.ToString("MMMM d, yyyy") — @day.Status — @day.BookingCount booking@(day.BookingCount == 1 ? "" : "s")" data-calendar-link data-calendar-day><strong>@day.Date.Day</strong><span class="custodian-day-state">@day.Status</span>@if (day.BookingCount > 0) { <small>@day.BookingCount booking@(day.BookingCount == 1 ? "" : "s")</small> }</a>
                        }
                    </div>
                    <div class="custodian-calendar-legend"><span><i class="available"></i> Available</span><span><i class="reserved"></i> Reserved / borrowed</span><span><i class="maintenance"></i> Maintenance</span></div>
                }
            </div>
        </section>
        <section class="live-panel" data-calendar-region="day" aria-live="polite"><h2>@Model.SelectedDay.ToString("dddd, MMMM d, yyyy", CultureInfo.InvariantCulture)</h2>
            @if (Model.SelectedItem is not null) { <p class="live-muted">@Model.SelectedItem.Name · @Model.SelectedItem.AssetCode</p> }
            @if (Model.Slots.Count == 0) { <p class="live-empty">No reservations overlap this day for the selected equipment.</p> }
            else { <div class="custodian-slots">@foreach (var slot in Model.Slots) { <article><div><strong>@slot.BorrowerName</strong><p>@slot.StartManila<br />Until @slot.EndManila</p><span class="live-badge">@slot.Status</span></div><a class="live-button secondary" href="/custodian/reservations/@slot.Id">View details</a></article> }</div> }
        </section>
        </div>
    </div>
</main>
@section Scripts {
    <script src="~/js/equipment-picker.js" asp-append-version="true"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
}
