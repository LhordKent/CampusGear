@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Password updated";
    ViewData["FigmaFrame"] = "917_11";
}
<section class="auth-card compact" aria-labelledby="account-title">
    <header>
        <h1 id="account-title">Password updated</h1>
    </header>
    <hr class="auth-divider" />
    <div class="auth-success-mark" aria-hidden="true">✓</div>
    <div class="auth-summary">
        <strong>Password updated</strong>
        <p>Sign in with your new password.</p>
    </div>
    <div class="auth-actions"><a class="auth-action" href="/auth/login">RETURN TO SIGN IN</a></div>
</section>
