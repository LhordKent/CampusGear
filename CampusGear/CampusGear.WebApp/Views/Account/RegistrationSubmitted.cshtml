@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Registration submitted";
    ViewData["FigmaFrame"] = "524_44";
}
<section class="auth-card compact" aria-labelledby="account-title">
    <header>
        <h1 id="account-title">Registration submitted</h1>
    </header>
    <hr class="auth-divider" />
    <div class="auth-success-mark" aria-hidden="true">✓</div>
    <div class="auth-summary">
        <strong>Pending approval</strong>
        <p>Your registration has been submitted. You can sign in once an administrator approves your account.</p>
    </div>
    <div class="auth-actions"><a class="auth-action" href="/auth/login">RETURN TO SIGN IN</a></div>
</section>
