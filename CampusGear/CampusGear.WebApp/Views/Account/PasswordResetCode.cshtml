@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Enter reset code";
    ViewData["FigmaFrame"] = ViewData["ErrorMessage"] is string || ViewData.ModelState.ErrorCount > 0 ? "405_2" : "15_30";
}
<section class="auth-card compact" aria-labelledby="account-title">
    <header>
        <p class="auth-step">02 / Verify code</p>
        <h1 id="account-title">Enter your reset code</h1>
        <p class="auth-description">We sent a 6-digit code to your email. If you requested more than one, use the newest code.</p>
    </header>
    <hr class="auth-divider" />
    @await Html.PartialAsync("_AccountFeedback")
    <form class="auth-form" action="/auth/password-reset-code" method="post">
        @Html.AntiForgeryToken()
        <label class="auth-field" for="Code"><span class="auth-field-label">Reset code</span>
            <input class="auth-input auth-code" id="Code" name="Code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••" required />
            @Html.ValidationMessage("Code", null, new { @class = "auth-field-error" })
        </label>
        <button class="auth-action" type="submit">VERIFY CODE</button>
    </form>
    <div class="auth-actions">
        <form class="auth-inline-form" action="/auth/resend-password-reset-code" method="post">@Html.AntiForgeryToken()<button type="submit">Resend code</button></form>
        <a class="auth-link" href="/auth/password-reset-request">Use a different email address</a>
    </div>
</section>
