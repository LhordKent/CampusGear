@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Set new password";
    ViewData["FigmaFrame"] = "822_14";
}
<section class="auth-card compact" aria-labelledby="account-title">
    <header>
        <p class="auth-step">03 / Reset password</p>
        <h1 id="account-title">Set your new password</h1>
    </header>
    <hr class="auth-divider" />
    @await Html.PartialAsync("_AccountFeedback")
    <form class="auth-form" action="/auth/password-reset-new" method="post">
        @Html.AntiForgeryToken()
        <label class="auth-field" for="Password"><span class="auth-field-label">New password</span>
            <input class="auth-input" id="Password" name="Password" type="password" placeholder="Enter a new password" autocomplete="new-password" minlength="8" required aria-describedby="password-help" />
            @Html.ValidationMessage("Password", null, new { @class = "auth-field-error" })
            <span class="auth-field-help" id="password-help">At least 8 characters, with uppercase and lowercase letters, a number, and a symbol.</span>
        </label>
        <label class="auth-field" for="ConfirmPassword"><span class="auth-field-label">Confirm password</span>
            <input class="auth-input" id="ConfirmPassword" name="ConfirmPassword" type="password" placeholder="Repeat your new password" autocomplete="new-password" minlength="8" required />
            @Html.ValidationMessage("ConfirmPassword", null, new { @class = "auth-field-error" })
        </label>
        <button class="auth-action" type="submit">UPDATE PASSWORD</button>
    </form>
</section>
