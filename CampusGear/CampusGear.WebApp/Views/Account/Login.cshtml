@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "Sign in";
    ViewData["FigmaFrame"] = "15_3";
    ViewData["StatusMessage"] = "CAMPUS AUTHENTICATION  •  READY FOR ACCOUNT VERIFICATION";
}
<section class="auth-card" aria-labelledby="account-title">
    <header>
        <p class="auth-eyebrow">Welcome back</p>
        <h1 id="account-title">Sign in to CampusGear</h1>
        <p class="auth-description">Use your campus email. You'll land in the right workspace for your role.</p>
    </header>
    <hr class="auth-divider" />
    @await Html.PartialAsync("_AccountFeedback")
    <form class="auth-form" action="/auth/login" method="post">
        @Html.AntiForgeryToken()
        <label class="auth-field" for="Email">
            <span class="auth-field-label">Campus email</span>
            <span class="auth-input-wrap">
                <svg class="icon auth-input-icon" aria-hidden="true"><use href="/icons.svg#mail"></use></svg>
                <input class="auth-input has-icon" id="Email" name="Email" type="email" value="@(ViewData["Email"] as string)" placeholder="name@campus.edu" autocomplete="username" required autofocus />
            </span>
            @Html.ValidationMessage("Email", null, new { @class = "auth-field-error" })
        </label>
        <div class="auth-field">
            <div class="auth-label-row">
                <label class="auth-field-label" for="Password">Password</label>
                <a class="auth-link" href="/auth/password-reset-request">Forgot password?</a>
            </div>
            <span class="auth-input-wrap">
                <svg class="icon auth-input-icon" aria-hidden="true"><use href="/icons.svg#lock"></use></svg>
                <input class="auth-input has-icon has-reveal" id="Password" name="Password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                @await Html.PartialAsync("_PasswordReveal", "Password")
            </span>
            @Html.ValidationMessage("Password", null, new { @class = "auth-field-error" })
        </div>
        <button class="auth-action" type="submit">Sign in</button>
    </form>
    <p class="auth-switch">New to CampusGear? <a class="auth-link" href="/auth/signup">Create an account</a></p>
</section>
