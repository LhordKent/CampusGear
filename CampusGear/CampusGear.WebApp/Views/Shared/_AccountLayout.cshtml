@{
    var frame = ViewData["FigmaFrame"] as string ?? "15_3";
    var title = ViewData["Title"] as string ?? "Account access";
    var sourceFrame = await Html.PartialAsync($"~/Pages/Figma/Frames/_{frame}.cshtml");
    using var sourceBuffer = new System.IO.StringWriter();
    sourceFrame.WriteTo(sourceBuffer, System.Text.Encodings.Web.HtmlEncoder.Default);
    // The original Figma signup uses mobile verification; CampusGear registration is verified by an administrator.
    var sourceMarkup = sourceBuffer.ToString()
        .Replace("MOBILE TRUST", "ADMINISTRATOR REVIEW", StringComparison.Ordinal)
        .Replace("One-time code required", "Approval required before sign-in", StringComparison.Ordinal)
        .Replace("mobile verification", "administrator approval", StringComparison.Ordinal)
        .Replace("registered mobile number", "registered email address", StringComparison.Ordinal)
        .Replace("REGISTERED MOBILE", "REGISTERED EMAIL", StringComparison.Ordinal)
        // The Figma export splits some descriptions mid-word across two lines; keep each word whole.
        .Replace("verifies i<", "verifies<", StringComparison.Ordinal).Replace(">dentity before", ">identity before", StringComparison.Ordinal)
        .Replace("return to secu<", "return to<", StringComparison.Ordinal).Replace(">re campus sign-in", ">secure campus sign-in", StringComparison.Ordinal)
        .Replace("campus contro<", "campus<", StringComparison.Ordinal).Replace(">ls behind", ">controls behind", StringComparison.Ordinal)
        .Replace("The administr<", "The<", StringComparison.Ordinal).Replace(">ator workspace", ">administrator workspace", StringComparison.Ordinal)
        .Replace("workspace is outsi<", "workspace is<", StringComparison.Ordinal).Replace(">de its assigned", ">outside its assigned", StringComparison.Ordinal);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071b2b" />
    <title>@title · CampusGear</title>
    <link rel="stylesheet" href="/css/figma-generated.css" />
    <link rel="stylesheet" href="/css/figma-app.css" />
    @await Html.PartialAsync("_AccountStyles")
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
</head>
<body class="auth-page">
    <div class="auth-backdrop" aria-hidden="true" inert>
        <div class="auth-figma-frame">
            @Html.Raw(sourceMarkup)
        </div>
    </div>
    <main class="auth-main" id="main-content">
        <div class="auth-mobile-brand">
            <img src="/figma/assets/7ef91.svg" alt="" />
            <span>CampusGear</span>
        </div>
        @RenderBody()
    </main>
    <script>
        // Scale the 1440×900 design art to the window so the backdrop reads as one piece at any size.
        (() => {
            const resize = () => document.body.style.setProperty('--auth-scale',
                Math.min(1.25, Math.max(0.75, Math.min(innerHeight / 900, innerWidth / 1500))).toFixed(3));
            resize();
            addEventListener('resize', resize);
        })();
    </script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
