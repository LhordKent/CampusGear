@{
    var errorMessage = ViewData["ErrorMessage"] as string;
    var noticeMessage = ViewData["NoticeMessage"] as string;
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="auth-error" role="alert">@errorMessage</div>
}
@* Field errors already show under their inputs; only form-level errors are listed here. *@
@if (ViewData.ModelState.TryGetValue(string.Empty, out var formState) && formState.Errors.Count > 0)
{
    <div class="auth-validation" role="alert">
        @Html.ValidationSummary(true)
    </div>
}
@if (!string.IsNullOrWhiteSpace(noticeMessage))
{
    <div class="auth-panel" role="status"><span>@noticeMessage</span></div>
}
