@using CampusGear.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject Microsoft.AspNetCore.Identity.UserManager<CampusGear.Models.ApplicationUser> WorkspaceUsers
@{
    var role = (string?)ViewData["WorkspaceRole"] ?? "Borrower";
    var slug = role == "Administrator" ? "admin" : role.ToLowerInvariant();
    var path = Context.Request.Path.Value ?? "";
    var account = await WorkspaceUsers.GetUserAsync(User);
    var name = account?.FullName ?? role;
    var initial = name.Length > 0 ? name[..1].ToUpperInvariant() : "C";
    var title = ViewData["Title"] as string ?? "Campus equipment workspace";
    var dashboard = path.EndsWith("/dashboard", StringComparison.OrdinalIgnoreCase);
    var verifiedLabel = role == "Administrator" ? "2FA VERIFIED" : role == "Custodian" ? "OPS READY" : "SYSTEM READY";
    var avatar = role == "Borrower" ? "a698b.svg" : "2680a.svg";
    var sidebarAvatar = role == "Administrator" ? "7ac1a.svg" : "6632a.svg";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071b2b" />
    <title>@title · CampusGear</title>
    <link rel="stylesheet" href="~/css/live-workspace.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/figma-live.css" asp-append-version="true" />
</head>
<body class="workspace-@slug @(dashboard ? "is-dashboard" : "")" data-figma-source="@FigmaUi.Frame(path)">
    <a class="live-skip" href="#workspace-content">Skip to content</a>
    <div class="live-shell">
        <div class="live-atmosphere" aria-hidden="true" inert>
            <img class="live-atmosphere-base" src="/figma/assets/@FigmaUi.Atmosphere(role)" alt="" />
            <img class="live-atmosphere-detail" src="/figma/assets/@FigmaUi.Detail(role)" alt="" />
        </div>
        <aside class="live-sidebar">
            @if (role != "Borrower") { <img class="live-sidebar-signature" src="/figma/assets/@FigmaUi.Signature(role)" alt="" aria-hidden="true" /> }
            <a class="live-brand" href="/@slug/dashboard"><img src="/figma/assets/b95f3.svg" alt="" /><span>Campus<strong>Gear</strong></span></a>
            <div class="live-role">@role.ToUpperInvariant() WORKSPACE</div>
            <details class="live-navigation" open>
                <summary>Workspace menu</summary>
                <nav aria-label="Workspace navigation">
                    @foreach (var item in FigmaUi.Navigation(role))
                    {
                        var active = path.Equals(item.Path, StringComparison.OrdinalIgnoreCase) ||
                            item.Path == "/admin/users" && path.StartsWith("/admin/users/", StringComparison.OrdinalIgnoreCase);
                        <a class="@(active ? "live-nav-active" : "")" href="@item.Path" aria-current="@(active ? "page" : null)"><span class="live-nav-icon"><img src="/figma/assets/@item.Icon" alt="" /></span><span>@item.Label</span></a>
                    }
                    @if (role != "Borrower")
                    {
                        <details class="live-extra-navigation"><summary>More operations</summary>
                            @if (role == "Administrator")
                            { <a href="/admin/reservations">Reservation Management</a><a href="/admin/approvals">Approval &amp; Release</a><a href="/admin/returns">Return &amp; Condition Check</a> }
                            else { <a href="/custodian/history">Borrowing History</a> }
                            <a href="/admin/maintenance">Equipment Maintenance</a>
                        </details>
                    }
                </nav>
            </details>
            @if (role == "Borrower")
            {
                <div class="live-nav-ambient" aria-hidden="true"><p>CAMPUSGEAR / BORROWER</p><strong>SESSION ACTIVE</strong><span>EQUIPMENT ACCESS</span><div><img src="/figma/assets/f64d6.svg" alt="" /><img src="/figma/assets/6eb9d.svg" alt="" /><img src="/figma/assets/606cd.svg" alt="" /></div></div>
            }
            else
            {
                <div class="live-sidebar-profile"><span class="live-avatar"><img src="/figma/assets/@sidebarAvatar" alt="" /><b>@initial</b></span><div><strong>@name</strong><small>@role</small></div></div>
            }
            <form method="post" action="/auth/logout" class="live-logout">@Html.AntiForgeryToken()<button type="submit">Log out</button></form>
        </aside>
        <div class="live-main">
            <header class="live-topbar">
                <div class="live-topbar-title"><strong>@title</strong><small>@(role == "Borrower" ? "Campus equipment workspace" : role == "Custodian" ? "Manage requests, releases, and returns." : "Manage equipment, users, reservations, and audit records.")</small></div>
                <div class="live-topbar-account"><span class="live-status"><img src="/figma/assets/d3b6f.svg" alt="" />@verifiedLabel</span><span class="live-avatar"><img src="/figma/assets/@avatar" alt="" /><b>@initial</b></span><div><strong>@name</strong><small>@role</small></div></div>
            </header>
            <div id="workspace-content" tabindex="-1">@RenderBody()</div>
        </div>
    </div>
    <script src="~/js/figma-live.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
