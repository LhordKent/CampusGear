@using CampusGear.Models
@model AdminUsersPage
@{
    Layout = "_WorkspaceLayout";
    var borrowers = Context.Request.Path == "/admin/borrowers";
    var basePath = borrowers ? "/admin/borrowers" : "/admin/users";
    ViewData["Title"] = Model.Status == "pending" ? "Registration Verification" : borrowers ? "Borrower Profiles" : "User & Role Management";
    ViewData["WorkspaceRole"] = "Administrator";
    var roles = new[] { "Borrower", "Custodian", "Administrator" };
    var returnUrl = ScreenUrls.Query(basePath, new { q = Model.Query, role = Model.Role, status = Model.Status, page = Model.Page });
}
<main class="live-content" data-figma-source="@(borrowers ? "695:6398" : "695:7067")">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">People</p>
            <h1>@(Model.Status == "pending" ? "Registration Verification" : borrowers ? "Borrower Profiles" : "User & Role Management")</h1>
            <p class="page-description">@(Model.Status == "pending"
                ? "New sign-ups waiting for approval. The latest submissions are listed first."
                : borrowers ? "Student borrowers, their department, and whether they can borrow. Newest accounts first."
                : "Every account in CampusGear with its role and status. Newest accounts first.")</p>
        </div>
        <div class="page-header-actions">
            @if (Model.Status == "pending") { <a class="live-button secondary" href="@basePath">Show all accounts</a> }
            else if (Model.PendingTotal > 0) { <a class="live-button secondary" href="@basePath?status=pending">Verify registrations<span class="live-count">@Model.PendingTotal</span></a> }
            <a class="live-button" href="/admin/users/new@(borrowers ? "?role=Borrower" : "")"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg>@(borrowers ? "Add borrower" : "Create account")</a>
        </div>
    </header>
    @if (Model.Feedback is not null)
    {
        <div class="live-feedback" role="status" data-toast="success">@Model.Feedback</div>
    }
    @if (Model.Error is not null)
    {
        <div class="live-feedback error" role="alert" data-toast="error">@Model.Error</div>
    }
    <section class="live-panel" aria-label="Accounts">
        <form class="live-filters" method="get" action="@basePath" role="search" aria-label="Find user accounts" data-live-search data-live-target="#user-results">
            <label for="q" class="live-filter-search">Search accounts<span class="live-search-input"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search"></use></svg><input id="q" name="q" type="search" value="@Model.Query" maxlength="120" placeholder="Name, email, Student ID, or department" autocomplete="off" /></span></label>
            @if (!borrowers) { <label for="role">Role<select id="role" name="role"><option value="all" selected="@(Model.Role == "all")">All roles</option>
                @foreach (var role in roles) { <option value="@role" selected="@(Model.Role == role)">@role</option> }
            </select></label> }
            <label for="status">Account status<select id="status" name="status">
                <option value="all" selected="@(Model.Status == "all")">All accounts</option>
                <option value="pending" selected="@(Model.Status == "pending")">Pending approval</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                <option value="rejected" selected="@(Model.Status == "rejected")">Rejected</option>
            </select></label>
            <a class="live-button secondary live-filter-reset" href="@basePath" data-live-reset>Clear</a>
        </form>
        <div id="user-results" class="live-results">
        <p class="live-result-count" data-live-count>@Model.Total matching account@(Model.Total == 1 ? "" : "s")</p>
        @if (Model.Rows.Count == 0)
        {
            <div class="live-empty"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search"></use></svg><h3>@(Model.Status == "pending" && string.IsNullOrEmpty(Model.Query) ? "No registrations are waiting" : "No matching accounts")</h3><p>@(Model.Status == "pending" && string.IsNullOrEmpty(Model.Query) ? "New sign-ups will appear here for approval." : "Try another name, email, or filter.")</p></div>
        }
        else
        {
            <div class="live-table-wrap" tabindex="0" aria-label="User accounts table">
                <table class="live-table">
                    <thead><tr><th scope="col">NAME</th><th scope="col">STUDENT ID NUMBER</th><th scope="col">EMAIL</th><th scope="col">@(borrowers ? "DEPARTMENT" : "ROLE")</th><th scope="col">STATUS</th><th scope="col">REGISTERED</th><th scope="col">ACTION</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var status = row.ApprovalStatus switch
                        {
                            AccountApprovalStatus.PendingApproval => "Pending approval",
                            AccountApprovalStatus.Rejected => "Rejected",
                            _ => row.IsActive ? "Active" : "Inactive"
                        };
                        <tr>
                            <td><strong>@row.FullName</strong></td>
                            <td>@(row.StudentNumber ?? "—")</td>
                            <td>@row.Email</td>
                            <td>@if (borrowers) { @(row.Department ?? "—") } else { <span class="live-badge">@(row.Role.Length > 0 ? row.Role : "No role")</span> }</td>
                            <td><span class="live-badge">@status</span>
                                @if (row.IsEligible is false) { <small>Borrowing access paused</small> }
                            </td>
                            <td class="live-nowrap">@row.RegisteredManila</td>
                            <td><div class="admin-user-actions">
                                @if (row.ApprovalStatus != AccountApprovalStatus.Approved)
                                {
                                    <form method="post" action="/admin/users/@row.Id/approve">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@returnUrl" /><button class="live-button" type="submit" aria-label="Approve @row.FullName">Approve</button></form>
                                }
                                @if (row.ApprovalStatus == AccountApprovalStatus.PendingApproval)
                                {
                                    <form method="post" action="/admin/users/@row.Id/reject">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@returnUrl" /><button class="live-button danger" type="submit" aria-label="Reject @row.FullName">Reject</button></form>
                                }
                                <a class="live-button secondary" href="/admin/users/@row.Id/edit">Edit</a>
                                <form method="post" action="/admin/users/@row.Id/delete" onsubmit="return confirm('Delete this account? Accounts with borrowing history are deactivated instead.')">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@returnUrl" /><button class="live-button secondary" type="submit" aria-label="Delete @row.FullName">Delete</button></form>
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <nav class="live-pager" aria-label="User account pages">
                @if (Model.Page > 1)
                { <a class="live-button secondary" href="@ScreenUrls.Query(basePath, new { q = Model.Query, role = Model.Role, status = Model.Status, page = Model.Page - 1 })" data-live-page>Previous</a> }
                <span>Page @Model.Page of @Model.PageCount</span>
                @if (Model.Page < Model.PageCount)
                { <a class="live-button secondary" href="@ScreenUrls.Query(basePath, new { q = Model.Query, role = Model.Role, status = Model.Status, page = Model.Page + 1 })" data-live-page>Next</a> }
            </nav>
        }
        </div>
    </section>
</main>
