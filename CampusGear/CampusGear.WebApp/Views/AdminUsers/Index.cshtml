@using CampusGear.Models
@model AdminUsersPage
@{
    Layout = "_WorkspaceLayout";
    var borrowers = Context.Request.Path == "/admin/borrowers";
    var basePath = borrowers ? "/admin/borrowers" : "/admin/users";
    ViewData["Title"] = borrowers ? "Borrower Profiles" : "User & Role Management";
    ViewData["WorkspaceRole"] = "Administrator";
    var roles = new[] { "Borrower", "Custodian", "Administrator" };
    var returnUrl = ScreenUrls.Query(basePath, new { q = Model.Query, role = Model.Role, status = Model.Status, page = Model.Page });
}
<main class="live-content" data-figma-source="@(borrowers ? "695:6398" : "695:7067")">
    <header class="live-heading">
        <h1>@(borrowers ? "Borrower Profiles" : "User & Role Management")</h1>
        @if (Model.PendingTotal > 0 && Model.Status != "pending")
        { <a class="live-button heading-action" href="@basePath?status=pending">Review pending approvals (@Model.PendingTotal)</a> }
    </header>
    @if (Model.Feedback is not null)
    {
        <div class="live-feedback" role="status">@Model.Feedback</div>
    }
    @if (Model.Error is not null)
    {
        <div class="live-feedback error" role="alert">@Model.Error</div>
    }
    <section class="live-panel" aria-label="Accounts">
        <form class="live-filters" method="get" action="@basePath" aria-label="Find user accounts">
            <label for="q">Search name, email, Student ID Number, or department<input id="q" name="q" value="@Model.Query" maxlength="120" type="search" /></label>
            @if (!borrowers) { <label for="role">Role<select id="role" name="role"><option value="all" selected="@(Model.Role == "all")">All roles</option>
                @foreach (var role in roles) { <option value="@role" selected="@(Model.Role == role)">@role</option> }
            </select></label> }
            <label for="status">Account status<select id="status" name="status">
                <option value="all" selected="@(Model.Status == "all")">All accounts</option>
                <option value="pending" selected="@(Model.Status == "pending")">Pending approval</option>
                <option value="active" selected="@(Model.Status == "active")">Active</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive</option>
                <option value="rejected" selected="@(Model.Status == "rejected")">Rejected</option>
            </select></label>
            <button class="live-button" type="submit">Search</button>
            <a class="live-button secondary" href="@basePath">Clear</a>
        </form>
        <p class="live-muted">@Model.Total matching account@(Model.Total == 1 ? "" : "s")</p>
        @if (Model.Rows.Count == 0)
        {
            <p class="live-empty">@(Model.Status == "pending" ? "No registrations are waiting for approval." : "No accounts match these filters.")</p>
        }
        else
        {
            <div class="live-table-wrap" tabindex="0" aria-label="User accounts table">
                <table class="live-table">
                    <thead><tr><th scope="col">NAME</th><th scope="col">STUDENT ID NUMBER</th><th scope="col">EMAIL</th><th scope="col">@(borrowers ? "DEPARTMENT" : "ROLE")</th><th scope="col">STATUS</th><th scope="col">ACTION</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var status = row.ApprovalStatus switch
                        {
                            AccountApprovalStatus.PendingApproval => "Pending approval",
                            AccountApprovalStatus.Rejected => "Rejected",
                            _ => row.IsActive ? "Active" : "Inactive"
                        };
                        <tr>
                            <td><strong>@row.FullName</strong></td>
                            <td>@(row.StudentNumber ?? "—")</td>
                            <td>@row.Email</td>
                            <td>@if (borrowers) { @(row.Department ?? "—") } else { <span class="live-badge">@(row.Role.Length > 0 ? row.Role : "No role")</span> }</td>
                            <td><span class="live-badge">@status</span>
                                @if (row.IsEligible is false) { <small>Borrowing access paused</small> }
                            </td>
                            <td><div class="admin-user-actions">
                                @if (row.ApprovalStatus != AccountApprovalStatus.Approved)
                                {
                                    <form method="post" action="/admin/users/@row.Id/approve">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@returnUrl" /><button class="live-button" type="submit" aria-label="Approve @row.FullName">Approve</button></form>
                                }
                                @if (row.ApprovalStatus == AccountApprovalStatus.PendingApproval)
                                {
                                    <form method="post" action="/admin/users/@row.Id/reject">@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@returnUrl" /><button class="live-button danger" type="submit" aria-label="Reject @row.FullName">Reject</button></form>
                                }
                                <a class="live-button secondary" href="/admin/users/@row.Id/edit">Edit</a>
                            </div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <nav class="live-pager" aria-label="User account pages">
                @if (Model.Page > 1)
                { <a class="live-button secondary" href="@ScreenUrls.Query(basePath, new { q = Model.Query, role = Model.Role, status = Model.Status, page = Model.Page - 1 })">Previous</a> }
                <span>Page @Model.Page of @Model.PageCount</span>
                @if (Model.Page < Model.PageCount)
                { <a class="live-button secondary" href="@ScreenUrls.Query(basePath, new { q = Model.Query, role = Model.Role, status = Model.Status, page = Model.Page + 1 })">Next</a> }
            </nav>
        }
    </section>
</main>
