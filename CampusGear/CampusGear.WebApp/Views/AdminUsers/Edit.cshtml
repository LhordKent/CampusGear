@using CampusGear.Models
@model AdminUserEditPage
@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "Edit Account & Role";
    ViewData["WorkspaceRole"] = "Administrator";
    var roles = new[] { "Borrower", "Custodian", "Administrator" };
    var approved = Model.ApprovalStatus == AccountApprovalStatus.Approved;
    var approval = Model.ApprovalStatus switch
    {
        AccountApprovalStatus.PendingApproval => "Pending approval",
        AccountApprovalStatus.Rejected => "Registration rejected",
        _ => "Approved"
    };
}
<main class="live-content" data-figma-source="695:7445">
    <header class="live-heading">
        <h1>Edit Account &amp; Role</h1>
    </header>
    <section class="live-panel live-editor-sheet" aria-label="Account information">
        @Html.ValidationSummary(false)

        @if (Model.IsSelf)
        { <p class="live-feedback" role="note">Your own account must stay active with Administrator access.</p> }
        @if (!approved)
        { <p class="live-feedback" role="note">This account must be approved before staff access can be assigned.</p> }
        <form id="account-editor-form" class="live-form live-form-three" method="post" action="/admin/users/@Model.Id/edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ConcurrencyStamp" value="@Model.Input.ConcurrencyStamp" />
            <input type="hidden" name="ProfileRowVersion" value="@Model.Input.ProfileRowVersion" />
            <label class="live-field" for="FirstName"><span>FIRST NAME</span>
                <input id="FirstName" name="FirstName" value="@Model.Input.FirstName" required maxlength="100" autocomplete="given-name" />
                @Html.ValidationMessage("FirstName")
            </label>
            <label class="live-field" for="LastName"><span>LAST NAME</span>
                <input id="LastName" name="LastName" value="@Model.Input.LastName" required maxlength="100" autocomplete="family-name" />
                @Html.ValidationMessage("LastName")
            </label>
            <div class="live-field live-readonly"><span>EMAIL</span><strong>@Model.Email</strong><small>@approval</small></div>
            <label class="live-field" for="Department"><span>DEPARTMENT</span>
                <input id="Department" name="Department" value="@Model.Input.Department" maxlength="160" />
                @Html.ValidationMessage("Department")
            </label>
            <div class="live-field live-readonly"><span>CONTACT</span><strong>@(Model.ContactNumber ?? "Not recorded")</strong></div>
            <label class="live-field" for="Role"><span>ROLE</span>
                <select id="Role" name="Role" disabled="@Model.IsSelf">
                    @foreach (var role in roles)
                    { <option value="@role" selected="@(Model.Input.Role == role)" disabled="@(!approved && role != "Borrower")">@role</option> }
                </select>
                @if (Model.IsSelf) { <input type="hidden" name="Role" value="Administrator" /> }
                @Html.ValidationMessage("Role")
            </label>
            <div class="live-field">
                <span>STATUS</span>
                <label class="live-check" for="IsActive"><input id="IsActive" name="IsActive" type="checkbox" value="true" checked="@Model.Input.IsActive" disabled="@Model.IsSelf" />Account is active</label>
                <input type="hidden" name="IsActive" value="@(Model.IsSelf ? "true" : "false")" />
                <p class="live-muted">Deactivation signs the user out. Their reservations and history stay intact.</p>
            </div>
            <details class="wide live-profile-fields" open="@(Model.CurrentRole == "Borrower")"><summary>Borrower profile &amp; borrowing access</summary><div class="live-form">
            @if (!Model.HasBorrowerProfile)
            { <p class="live-muted wide">Profile details are created when Borrower is selected. Leave these fields empty when assigning a staff role.</p> }
            <label class="live-field" for="StudentNumber"><span>STUDENT ID NUMBER</span>
                <input id="StudentNumber" name="StudentNumber" value="@Model.Input.StudentNumber" maxlength="64" />
                @Html.ValidationMessage("StudentNumber")
            </label>

            <div class="live-field wide">
                <span>BORROWING ACCESS</span>
                <label class="live-check" for="IsEligible"><input id="IsEligible" name="IsEligible" type="checkbox" value="true" checked="@Model.Input.IsEligible" />Eligible to reserve equipment</label>
                <input type="hidden" name="IsEligible" value="false" />
            </div>
            <label class="live-field wide" for="EligibilityNotes"><span>ELIGIBILITY NOTES</span>
                <textarea id="EligibilityNotes" name="EligibilityNotes" maxlength="1000">@Model.Input.EligibilityNotes</textarea>
                @Html.ValidationMessage("EligibilityNotes")
            </label>
            </div></details>
            <p class="live-muted wide">Role and status changes require the user to sign in again.</p>
        </form>
    </section>
    <partial name="_EditorFooter" model='new CampusGear.Models.FigmaEditorFooter("account-editor-form", "/admin/users")' />
</main>
