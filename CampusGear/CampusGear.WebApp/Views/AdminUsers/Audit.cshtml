@model AdminAuditPage
@{
    Layout = "_WorkspaceLayout";
    ViewData["Title"] = "System Audit Log";
    ViewData["WorkspaceRole"] = "Administrator";
}
@section Styles { <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" /> }
<main class="live-content" data-figma-source="945:195">
    <header class="live-heading">
        <p class="live-eyebrow">ADMINISTRATOR • WORKSPACE</p>
        <h1>System Audit Log</h1>
        <p>Review account and equipment activity. Audit records are read-only and times are shown in Manila time.</p>
    </header>
    <section class="live-panel" aria-labelledby="audit-title">
        <h2 id="audit-title">AUDIT HISTORY</h2>
        <form class="live-filters" method="get" action="/admin/audit" aria-label="Search audit history">
            <label for="q">Search action, actor, record, result, or IP address<input id="q" name="q" type="search" value="@Model.Query" maxlength="120" /></label>
            <button class="live-button" type="submit">Search</button><a class="live-button secondary" href="/admin/audit">Clear</a>
        </form>
        <p class="live-muted">@Model.Total matching event@(Model.Total == 1 ? "" : "s")</p>
        @if (Model.Rows.Count == 0)
        { <p class="live-empty">No audit events match this search.</p> }
        else
        {
            <div class="live-table-wrap" tabindex="0" aria-label="Audit events table">
                <table class="live-table">
                    <thead><tr><th scope="col">TIME</th><th scope="col">ACTION / ACTOR</th><th scope="col">RECORD</th><th scope="col">RESULT</th><th scope="col">DETAILS</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.TimeManila</td>
                            <td><strong>@row.Action</strong><small>@row.ActorName</small><small>@row.ActorEmail</small></td>
                            <td>@row.EntityType<small>@row.EntityId</small></td>
                            <td><span class="live-badge">@row.Outcome</span></td>
                            <td><details><summary>View details</summary>
                                <p class="live-muted">IP: @(row.IpAddress ?? "Not recorded")<br />Request: @(row.CorrelationId ?? "Not recorded")</p>
                                @if (row.BeforeJson is not null) { <h3>Before</h3><pre class="admin-audit-json">@row.BeforeJson</pre> }
                                @if (row.AfterJson is not null) { <h3>After</h3><pre class="admin-audit-json">@row.AfterJson</pre> }
                            </details></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <nav class="live-pager" aria-label="Audit history pages">
                @if (Model.Page > 1)
                { <a class="live-button secondary" href="@ScreenUrls.Query("/admin/audit", new { q = Model.Query, page = Model.Page - 1 })">Previous</a> }
                <span>Page @Model.Page of @Model.PageCount</span>
                @if (Model.Page < Model.PageCount)
                { <a class="live-button secondary" href="@ScreenUrls.Query("/admin/audit", new { q = Model.Query, page = Model.Page + 1 })">Next</a> }
            </nav>
        }
    </section>
</main>
