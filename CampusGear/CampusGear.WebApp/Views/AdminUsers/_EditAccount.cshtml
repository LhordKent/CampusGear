@using CampusGear.Models
@model AdminUserEditPage
@{
    var roles = new[] { "Borrower", "Custodian", "Administrator" };
    var approved = Model.ApprovalStatus == AccountApprovalStatus.Approved;
    var approval = Model.ApprovalStatus switch
    {
        AccountApprovalStatus.PendingApproval => "Pending approval",
        AccountApprovalStatus.Rejected => "Registration rejected",
        _ => "Approved"
    };
    var errors = ViewData.ModelState.TryGetValue("", out var summary) ? summary.Errors.Select(x => x.ErrorMessage).Distinct().ToList() : [];
}
<dialog id="account-editor" class="live-modal live-modal-wide" aria-labelledby="account-editor-title" data-modal-autoshow data-modal-return="/admin/users" data-figma-source="695:7445">
    <div class="live-modal-head">
        <div><p class="page-eyebrow">@Model.Email · @approval</p><h2 id="account-editor-title">Edit Account &amp; Role</h2></div>
        <button class="live-modal-close" type="button" data-modal-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="/icons.svg#x"></use></svg></button>
    </div>
    @if (Model.IsSelf)
    { <p class="live-modal-lede" role="note">Your own account must stay active with Administrator access.</p> }
    @if (!approved)
    { <p class="live-modal-lede" role="note">This account must be approved before staff access can be assigned.</p> }
    <form id="account-editor-form" class="live-form" method="post" action="/admin/users/@Model.Id/edit" data-modal-form novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ConcurrencyStamp" value="@Model.Input.ConcurrencyStamp" />
        <input type="hidden" name="ProfileRowVersion" value="@Model.Input.ProfileRowVersion" />
        <div class="live-modal-alert wide" role="alert" data-modal-alert hidden="@(errors.Count == 0)">@string.Join(" ", errors)</div>
        <p class="form-section-title wide">Account</p>
        <label class="live-field" for="FirstName"><span>First name</span>
            <input id="FirstName" name="FirstName" value="@Model.Input.FirstName" required maxlength="100" autocomplete="given-name" />
            @Html.ValidationMessage("FirstName")
        </label>
        <label class="live-field" for="LastName"><span>Last name</span>
            <input id="LastName" name="LastName" value="@Model.Input.LastName" required maxlength="100" autocomplete="family-name" />
            @Html.ValidationMessage("LastName")
        </label>
        <div class="live-field live-readonly span-4"><span>Email</span><strong>@Model.Email</strong><small>@approval</small></div>
        <div class="live-field live-readonly span-2"><span>Contact</span><strong>@(Model.ContactNumber ?? "Not recorded")</strong></div>
        <label class="live-field wide" for="Department"><span>Department</span>
            <input id="Department" name="Department" value="@Model.Input.Department" maxlength="160" />
            @Html.ValidationMessage("Department")
        </label>
        <p class="form-section-title wide">Access</p>
        <label class="live-field span-2" for="Role"><span>Role</span>
            <select id="Role" name="Role" disabled="@Model.IsSelf">
                @foreach (var role in roles)
                { <option value="@role" selected="@(Model.Input.Role == role)" disabled="@(!approved && role != "Borrower")">@role</option> }
            </select>
            @if (Model.IsSelf) { <input type="hidden" name="Role" value="Administrator" /> }
            @Html.ValidationMessage("Role")
        </label>
        <div class="live-field span-4">
            <span>Status</span>
            <label class="live-check" for="IsActive"><input id="IsActive" name="IsActive" type="checkbox" value="true" checked="@Model.Input.IsActive" disabled="@Model.IsSelf" />Account is active</label>
            <input type="hidden" name="IsActive" value="@(Model.IsSelf ? "true" : "false")" />
            <p class="live-help">Deactivation signs the user out. Their reservations and history stay intact.</p>
        </div>
        <details class="wide live-profile-fields" open="@(Model.CurrentRole == "Borrower")"><summary>Borrower profile &amp; borrowing access</summary><div class="live-form live-form-nested">
        @if (!Model.HasBorrowerProfile)
        { <p class="live-help wide">Profile details are created when Borrower is selected. Leave these fields empty when assigning a staff role.</p> }
        <label class="live-field span-2" for="StudentNumber"><span>Student ID Number</span>
            <input id="StudentNumber" name="StudentNumber" value="@Model.Input.StudentNumber" maxlength="64" />
            @Html.ValidationMessage("StudentNumber")
        </label>
        <div class="live-field wide">
            <span>Borrowing access</span>
            <label class="live-check" for="IsEligible"><input id="IsEligible" name="IsEligible" type="checkbox" value="true" checked="@Model.Input.IsEligible" />Eligible to reserve equipment</label>
            <input type="hidden" name="IsEligible" value="false" />
        </div>
        <label class="live-field wide" for="EligibilityNotes"><span>Eligibility notes <small>Optional</small></span>
            <textarea id="EligibilityNotes" name="EligibilityNotes" maxlength="1000" rows="3">@Model.Input.EligibilityNotes</textarea>
            @Html.ValidationMessage("EligibilityNotes")
        </label>
        </div></details>
        <p class="live-help wide">Role and status changes require the user to sign in again.</p>
        <div class="live-modal-actions wide">
            <button class="live-button secondary" type="button" data-modal-close>Cancel</button>
            <button class="live-button" type="submit">Save changes</button>
        </div>
    </form>
</dialog>
