@model CategoriesPageModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Equipment Categories"; ViewData["WorkspaceRole"] = "Administrator";
   var editor = Model.Input.Id is not null || Context.Request.Query["form"] == "add" || !ViewData.ModelState.IsValid; }
<main class="live-content" data-figma-source="695:4991">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">Inventory</p>
            <h1>Equipment Categories</h1>
            <p class="page-description">Group equipment so borrowers can browse it and staff can report on it. Newest categories appear first.</p>
        </div>
        <div class="page-header-actions">
            <a class="live-button" href="/admin/categories?form=add" data-modal-load><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg>Add category</a>
        </div>
    </header>
    @if (Model.Feedback is not null) { <div class="live-feedback" role="status" data-toast="success">@Model.Feedback</div> }
    <section class="live-panel" aria-labelledby="categories-title">
        <h2 id="categories-title">Category records</h2>
        <form class="live-filters" method="get" action="/admin/categories" role="search" aria-label="Find categories" data-live-search data-live-target="#category-results">
            <label for="category-q" class="live-filter-search">Search categories<span class="live-search-input"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search"></use></svg><input id="category-q" name="q" type="search" value="@Model.Query" maxlength="120" placeholder="Name or description" autocomplete="off" /></span></label>
            <a class="live-button secondary live-filter-reset" href="/admin/categories" data-live-reset>Clear</a>
        </form>
        <div id="category-results" class="live-results" data-refresh-region>
            <p class="live-result-count" data-live-count>@(string.IsNullOrEmpty(Model.Query) ? $"{Model.Total} categor{(Model.Total == 1 ? "y" : "ies")}" : $"{Model.Categories.Count} of {Model.Total} categories match")</p>
            @if (Model.Categories.Count == 0)
            {
                <div class="live-empty">
                    <svg class="icon" aria-hidden="true"><use href="/icons.svg#@(Model.Total == 0 ? "tag" : "search")"></use></svg>
                    <h3>@(Model.Total == 0 ? "No categories yet" : "No matching categories")</h3>
                    <p>@(Model.Total == 0 ? "Add a category to organize your equipment." : "Try another name or description.")</p>
                </div>
            }
            else
            {
                <div class="live-table-wrap" tabindex="0" role="region" aria-label="Equipment categories">
                    <table class="live-table">
                        <thead><tr><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Items</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
                        <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr><td><strong>@category.Name</strong></td><td>@(category.Description ?? "—")</td><td>@category.Items</td><td><span class="live-badge">@(category.IsActive ? "Active" : "Inactive")</span></td>
                                <td><div class="admin-user-actions"><a class="live-button secondary" href="/admin/categories?id=@category.Id" data-modal-load>Edit</a><form method="post" action="/admin/categories/@category.Id/delete" onsubmit="return confirm('Delete this category? A category that still holds equipment is deactivated instead.')">@Html.AntiForgeryToken()<button class="live-button secondary" type="submit" aria-label="Delete @category.Name">Delete</button></form></div></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    @if (editor) { <partial name="_CategoryEditor" model="Model" /> }
</main>
@section Scripts { <script src="~/js/modal-forms.js" asp-append-version="true"></script> }
