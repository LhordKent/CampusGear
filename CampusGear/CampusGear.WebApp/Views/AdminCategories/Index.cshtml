@model CategoriesPageModel
@{ Layout = "_WorkspaceLayout"; ViewData["Title"] = "Equipment Categories"; ViewData["WorkspaceRole"] = "Administrator";
   var editor = Model.Input.Id is not null || Context.Request.Query["form"] == "add" || !ViewData.ModelState.IsValid; }
<main class="live-content" data-figma-source="@(editor ? Model.Input.Id is null ? "695:5184" : "695:5347" : "695:4991")">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">Inventory</p>
            <h1>@(editor ? Model.Input.Id is null ? "Add Equipment Category" : "Edit Equipment Category" : "Equipment Categories")</h1>
            <p class="page-description">@(editor ? "Categories group equipment in the borrower catalog and on reports." : "Group equipment so borrowers can browse it and staff can report on it. Newest categories appear first.")</p>
        </div>
        <div class="page-header-actions">
            @if (editor) { <a class="live-button secondary" href="/admin/categories">Back to categories</a> }
            else { <a class="live-button" href="/admin/categories?form=add"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus"></use></svg>Add category</a> }
        </div>
    </header>
    @if (Model.Feedback is not null) { <div class="live-feedback" role="status" data-toast="success">@Model.Feedback</div> }
    @if (!editor) {
    <section class="live-panel" aria-labelledby="categories-title">
        <h2 id="categories-title">Category records</h2>
        <form class="live-filters" method="get" action="/admin/categories" role="search" aria-label="Find categories" data-live-search data-live-target="#category-results">
            <label for="category-q" class="live-filter-search">Search categories<span class="live-search-input"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search"></use></svg><input id="category-q" name="q" type="search" value="@Model.Query" maxlength="120" placeholder="Name or description" autocomplete="off" /></span></label>
            <a class="live-button secondary live-filter-reset" href="/admin/categories" data-live-reset>Clear</a>
        </form>
        <div id="category-results" class="live-results">
            <p class="live-result-count" data-live-count>@(string.IsNullOrEmpty(Model.Query) ? $"{Model.Total} categor{(Model.Total == 1 ? "y" : "ies")}" : $"{Model.Categories.Count} of {Model.Total} categories match")</p>
            @if (Model.Categories.Count == 0)
            {
                <div class="live-empty">
                    <svg class="icon" aria-hidden="true"><use href="/icons.svg#@(Model.Total == 0 ? "tag" : "search")"></use></svg>
                    <h3>@(Model.Total == 0 ? "No categories yet" : "No matching categories")</h3>
                    <p>@(Model.Total == 0 ? "Add a category to organize your equipment." : "Try another name or description.")</p>
                </div>
            }
            else
            {
                <div class="live-table-wrap" tabindex="0" role="region" aria-label="Equipment categories">
                    <table class="live-table">
                        <thead><tr><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Items</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
                        <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr><td><strong>@category.Name</strong></td><td>@(category.Description ?? "—")</td><td>@category.Items</td><td><span class="live-badge">@(category.IsActive ? "Active" : "Inactive")</span></td>
                                <td><div class="admin-user-actions"><a class="live-button secondary" href="/admin/categories?id=@category.Id">Edit</a><form method="post" action="/admin/categories/@category.Id/delete" onsubmit="return confirm('Delete this category? A category that still holds equipment is deactivated instead.')">@Html.AntiForgeryToken()<button class="live-button secondary" type="submit" aria-label="Delete @category.Name">Delete</button></form></div></td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
    }
    @if (editor)
    {
    <section class="live-panel live-editor-sheet form-narrow category-editor" aria-labelledby="category-editor-title">
        <h2 id="category-editor-title">Category information</h2>
        <div asp-validation-summary="All"></div>
        <form id="category-editor-form" method="post" action="/admin/categories/save" class="live-form">
            @Html.AntiForgeryToken()<input asp-for="Input.Id" type="hidden" /><input asp-for="Input.RowVersion" type="hidden" />
            <label class="live-field span-4"><span>Category name</span><input asp-for="Input.Name" required maxlength="120" placeholder="e.g. Cameras" /></label>
            <label class="live-field wide"><span>Description <small>Optional · shown to staff and borrowers</small></span><textarea asp-for="Input.Description" maxlength="1000" rows="3" placeholder="What kind of equipment belongs here?"></textarea></label>
            <div class="wide">
                <label class="live-check"><input asp-for="Input.IsActive" /> Active category</label>
                <p class="live-help">A category with active equipment must stay active.</p>
            </div>
        </form>
        <partial name="_EditorFooter" model='new CampusGear.Models.FigmaEditorFooter("category-editor-form", "/admin/categories")' />
    </section>
    }
</main>
