@using CampusGear.Services
@model IReadOnlyList<DevelopmentEmailMessage>
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><partial name="_ThemeHead" /><title>Development email · CampusGear</title><link rel="stylesheet" href="~/css/theme-tokens.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/live-workspace.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/figma-live.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" /></head>
<body><main class="live-content">
    <header class="live-heading development-email-heading"><div class="development-email-heading-copy"><h1>Development email inbox</h1><p>Password reset and administrator sign-in codes sent by this running instance appear here. Messages disappear when the app restarts.</p></div><div class="live-actions"><a class="live-button" href="/development/email">Refresh inbox</a><a class="live-button secondary" href="/auth/login">Sign in</a><partial name="_ThemeToggle" /></div></header>
    @if (Model.Count == 0) { <p class="live-empty">No emails yet.</p> }
    @foreach (var message in Model)
    { <article class="live-panel"><h2>@message.Subject</h2><p class="live-muted">To @message.ToEmail · @message.SentAtUtc.ToString("u")</p><p style="white-space:pre-wrap;overflow-wrap:anywhere">@message.Body</p></article> }
</main><script src="~/js/theme.js" asp-append-version="true"></script></body></html>
