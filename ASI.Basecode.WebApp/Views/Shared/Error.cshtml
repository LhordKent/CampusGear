@model ErrorViewModel
@{
    // Standalone on purpose: the error page must render even when a shared layout is what failed.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error - CampusGear</title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #071b2b; color: #e8f1f5; font: 15px/1.6 Inter, Arial, sans-serif; }
        main { max-width: 520px; padding: 32px 24px; }
        h1 { margin: 0 0 12px; font-size: 24px; }
        a { color: #7fd6c8; }
        code { color: #b8c7d1; }
    </style>
</head>
<body>
    <main>
        <h1>Something went wrong.</h1>
        <p>An error occurred while processing your request. Please try again.</p>
        @if (Model.ShowRequestId)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <p><a href="/auth/login">Back to sign in</a></p>
    </main>
</body>
</html>
