@{
    var title = ViewData["Title"] as string ?? "Account access";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071b2b" />
    <title>@title · CampusGear</title>
    <link rel="stylesheet" href="/css/figma-generated.css" />
    <link rel="stylesheet" href="/css/login.css" />
    @await Html.PartialAsync("_AccountStyles")
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
</head>
@* Each account page renders an .auth-split: an _AuthIntro beside its card. The backdrop only carries the faded corner art. *@
<body class="auth-page">
    <div class="auth-backdrop" aria-hidden="true"></div>
    <main class="auth-main" id="main-content">
        @RenderBody()
    </main>
    <script>
        // Password show/hide toggles rendered by _PasswordReveal.
        document.querySelectorAll('.auth-reveal[data-reveal]').forEach(button => {
            const input = document.getElementById(button.dataset.reveal);
            if (!input) return;
            button.addEventListener('click', () => {
                const show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                button.setAttribute('aria-pressed', String(show));
            });
            // Never submit with the password left visible on screen.
            input.form?.addEventListener('submit', () => {
                input.type = 'password';
                button.setAttribute('aria-pressed', 'false');
            });
        });
    </script>
    <script src="~/js/motion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
