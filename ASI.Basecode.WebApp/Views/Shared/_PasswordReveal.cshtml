@model string
@* Toggle for a password input; pass the input's id. The label stays constant and aria-pressed carries the state. Wired up in _AccountLayout. *@
<button class="auth-reveal" type="button" data-reveal="@Model" aria-controls="@Model" aria-label="@Account.ShowPassword" aria-pressed="false">
    <svg class="auth-reveal-icon auth-reveal-show" viewBox="0 0 24 24" aria-hidden="true"><use href="/img/icons.svg#eye"></use></svg>
    <svg class="auth-reveal-icon auth-reveal-hide" viewBox="0 0 24 24" aria-hidden="true"><use href="/img/icons.svg#eye-off"></use></svg>
</button>
