@* Live password checklist (length, number, ...) driven by wwwroot/js/password-rules.js. *@
@model PasswordRulesModel
@using ASI.Basecode.Services.Manager
@* Live password checklist (js/password-rules.js). The rules mirror ASP.NET Identity's checks set in PasswordManager:
   the length from PasswordManager.RequiredLength, plus one each of A–Z, a–z, 0–9, and any other character.
   Without JavaScript the list still reads as the requirements. *@
<ul class="password-rules" id="@Model.Id" data-password-rules="@Model.PasswordId" data-password-confirm="@Model.ConfirmId" data-min-length="@PasswordManager.RequiredLength" aria-label="Password requirements">
    <li data-rule="length">At least @PasswordManager.RequiredLength characters<span class="visually-hidden" data-rule-state></span></li>
    <li data-rule="upper">An uppercase letter (A–Z)<span class="visually-hidden" data-rule-state></span></li>
    <li data-rule="lower">A lowercase letter (a–z)<span class="visually-hidden" data-rule-state></span></li>
    <li data-rule="digit">A number (0–9)<span class="visually-hidden" data-rule-state></span></li>
    <li data-rule="symbol">A symbol, such as ! @@ # or $<span class="visually-hidden" data-rule-state></span></li>
    @if (!string.IsNullOrEmpty(Model.ConfirmId))
    {
        <li data-rule="match">Both passwords match<span class="visually-hidden" data-rule-state></span></li>
    }
</ul>
