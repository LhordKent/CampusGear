@using ASI.Basecode.WebApp.Models
@using ASI.Basecode.Resources.Constants
@using ASI.Basecode.Services.ServiceModels
@model UserEditPage
@{
    var roles = new[]
    {
        (Name: "Borrower", Icon: "users", Description: "Reserves and borrows equipment."),
        (Name: "Custodian", Icon: "check-circle", Description: "Approves requests, releases and receives equipment."),
        (Name: "Administrator", Icon: "shield", Description: "Manages accounts, inventory and settings."),
    };
    var approved = Model.ApprovalStatus == AccountApprovalStatus.Approved;
    var approval = Model.ApprovalStatus switch
    {
        AccountApprovalStatus.PendingApproval => "Pending approval",
        AccountApprovalStatus.Rejected => "Rejected",
        _ => Model.Input.IsActive ? "Active" : "Inactive"
    };
    var fullName = $"{Model.Input.FirstName} {Model.Input.LastName}".Trim();
    string? CancelWarning(int count, string action) => count == 0
        ? null
        : $"{action} cancels this student's {count} pending or approved {(count == 1 ? "booking" : "bookings")}. Turning it back on later does not restore {(count == 1 ? "it" : "them")}.";
    var deactivateWarning = CancelWarning(Model.CancelledByDeactivation, "Deactivating the account");
    var pauseWarning = CancelWarning(Model.CancelledByPause, "Pausing borrowing access");
    var initials = string.Concat(new[] { Model.Input.FirstName, Model.Input.LastName }
        .Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => char.ToUpperInvariant(x.Trim()[0])));
    var errors = ViewData.ModelState.TryGetValue("", out var summary) ? summary.Errors.Select(x => x.ErrorMessage).Distinct().ToList() : [];
}
<dialog id="account-editor" class="live-modal live-modal-wide account-editor" aria-labelledby="account-editor-title" data-modal-autoshow data-modal-return="/admin/users" data-figma-source="695:7445">
    <div class="live-modal-head">
        <div><p class="page-eyebrow">Users &amp; Roles</p><h2 id="account-editor-title">Edit account</h2></div>
        <button class="live-modal-close" type="button" data-modal-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#x"></use></svg></button>
    </div>

    @* Who is being edited: the same ID-style strip as the registration review. *@
    <section class="account-identity" aria-label="Account">
        <div class="borrowing-id-avatar" aria-hidden="true">@initials</div>
        <div class="account-identity-copy">
            <strong>@(fullName.Length > 0 ? fullName : Model.Email)</strong>
            <span>@Model.Email</span>
            <span>@(Model.ContactNumber ?? "No mobile number")</span>
        </div>
        <div class="account-identity-badges">
            <span class="live-badge" data-state="@approval.ToLowerInvariant()">@approval</span>
            <small>Registered @Model.RegisteredManila</small>
        </div>
    </section>

    <form id="account-editor-form" class="account-editor-form" method="post" action="/admin/users/@Model.Id/edit" data-modal-form novalidate
          data-confirm-title="Cancel this student's bookings?" data-confirm-ok="Save and cancel bookings" data-confirm-cancel="Go back">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ConcurrencyStamp" value="@Model.Input.ConcurrencyStamp" />
        <input type="hidden" name="ProfileRowVersion" value="@Model.Input.ProfileRowVersion" />
        <div class="live-modal-alert" role="alert" data-modal-alert hidden="@(errors.Count == 0)">@string.Join(" ", errors)</div>

        <fieldset class="account-section">
            <legend>Name</legend>
            <div class="account-grid">
                <label class="live-field" for="FirstName"><span>First name</span>
                    <input id="FirstName" name="FirstName" value="@Model.Input.FirstName" required maxlength="100" autocomplete="given-name" />
                    @Html.ValidationMessage("FirstName")
                </label>
                <label class="live-field" for="LastName"><span>Last name</span>
                    <input id="LastName" name="LastName" value="@Model.Input.LastName" required maxlength="100" autocomplete="family-name" />
                    @Html.ValidationMessage("LastName")
                </label>
            </div>
        </fieldset>

        <fieldset class="account-section">
            <legend>Role</legend>
            @if (Model.IsSelf)
            { <p class="account-note">Your own account always keeps Administrator access.</p> }
            else if (!approved)
            { <p class="account-note">Custodian and Administrator unlock after this registration is approved.</p> }
            <div class="account-roles" role="radiogroup" aria-label="Role">
                @foreach (var role in roles)
                {
                    var locked = Model.IsSelf || (!approved && role.Name != "Borrower");
                    <label class="account-role">
                        <input type="radio" name="Role" value="@role.Name" checked="@(Model.Input.Role == role.Name)" disabled="@locked" />
                        <span class="account-role-card">
                            <svg class="icon" aria-hidden="true"><use href="/img/icons.svg#@role.Icon"></use></svg>
                            <strong>@role.Name</strong>
                            <small>@role.Description</small>
                        </span>
                    </label>
                }
            </div>
            @if (Model.IsSelf) { <input type="hidden" name="Role" value="Administrator" /> }
            @Html.ValidationMessage("Role")
        </fieldset>

        <fieldset class="account-section">
            <legend>Access</legend>
            <label class="account-switch" for="IsActive">
                <input id="IsActive" name="IsActive" type="checkbox" role="switch" value="true" checked="@Model.Input.IsActive" disabled="@Model.IsSelf" data-confirm-on-uncheck="@deactivateWarning" />
                <span class="account-switch-copy"><strong>Account is active</strong><small>Inactive accounts can't sign in. Their reservations and history are kept.</small></span>
            </label>
            <input type="hidden" name="IsActive" value="@(Model.IsSelf ? "true" : "false")" />
        </fieldset>

        @* Shown only while Borrower is the selected role (CSS :has in main.css). *@
        <fieldset class="account-section account-borrower">
            <legend>Borrower profile</legend>
            @if (!Model.HasBorrowerProfile)
            { <p class="account-note">A borrower profile is created when you save with Borrower selected.</p> }
            <div class="account-grid">
                <label class="live-field" for="StudentNumber"><span>Student ID Number</span>
                    <input id="StudentNumber" name="StudentNumber" value="@Model.Input.StudentNumber" maxlength="64" />
                    @Html.ValidationMessage("StudentNumber")
                </label>
                <label class="live-field" for="Department"><span>Department</span>
                    <select id="Department" name="Department">
                        @await Html.PartialAsync("_DepartmentOptions", new DepartmentOptionsModel(Model.Input.Department, "No department", AllowEmpty: true))
                    </select>
                    @Html.ValidationMessage("Department")
                </label>
            </div>
            <label class="account-switch" for="IsEligible">
                <input id="IsEligible" name="IsEligible" type="checkbox" role="switch" value="true" checked="@Model.Input.IsEligible" data-confirm-on-uncheck="@pauseWarning" />
                <span class="account-switch-copy"><strong>Can reserve equipment</strong><small>Turn off to pause this student's borrowing without deactivating the account.</small></span>
            </label>
            <input type="hidden" name="IsEligible" value="false" />
            <label class="live-field" for="EligibilityNotes"><span>Reason for pausing <small>Optional</small></span>
                <textarea id="EligibilityNotes" name="EligibilityNotes" maxlength="1000" rows="2" placeholder="e.g. Overdue equipment not yet returned">@Model.Input.EligibilityNotes</textarea>
                @Html.ValidationMessage("EligibilityNotes")
            </label>
        </fieldset>

        <div class="live-modal-actions">
            <p class="account-actions-note">Changing the role or status signs the user out.</p>
            <button class="live-button secondary" type="button" data-modal-close>Cancel</button>
            <button class="live-button" type="submit">Save changes</button>
        </div>
    </form>
</dialog>
