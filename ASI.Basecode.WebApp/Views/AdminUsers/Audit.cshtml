@model AdminAuditPage
@{
    ViewData["Title"] = TitleText.SystemAuditLog;
    ViewData["WorkspaceRole"] = "Administrator";
}
@section Styles { <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" /> }
<main class="live-content" data-figma-source="945:195">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">People</p>
            <h1>System Audit Log</h1>
            <p class="page-description">Who did what in CampusGear: sign-ins, account changes, reservations, and equipment updates. Newest first, in Manila time.</p>
        </div>
    </header>
    <section class="live-panel" aria-label="Audit history">
        <form class="live-filters" method="get" action="/admin/audit" role="search" aria-label="Search audit history" data-live-search data-live-target="#audit-results">
            <label for="q" class="live-filter-search">Search audit events<span class="live-search-input"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search"></use></svg><input id="q" name="q" type="search" value="@Model.Query" maxlength="120" placeholder="Search by name or email" autocomplete="off" /></span></label>
            <a class="live-button secondary live-filter-reset" href="/admin/audit" data-live-reset>Clear</a>
        </form>
        <div id="audit-results" class="live-results">
        <p class="live-result-count" data-live-count>@Model.Total recorded activit@(Model.Total == 1 ? "y" : "ies")</p>
        @if (Model.Rows.Count == 0)
        { <div class="live-empty"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search"></use></svg><h3>No matching activity</h3><p>Try another name or email.</p></div> }
        else
        {
            <div class="live-table-wrap" tabindex="0" aria-label="Activity table">
                <table class="live-table">
                    <thead><tr><th scope="col">@Table.When</th><th scope="col">@Table.Who</th><th scope="col">@Table.WhatHappened</th><th scope="col">@Table.Result</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="live-nowrap">@row.TimeManila</td>
                            <td><strong>@row.Who</strong>@if (row.WhoEmail is not null) { <small>@row.WhoEmail</small> }</td>
                            <td>@row.WhatHappened</td>
                            <td><span class="live-badge" data-state="@row.ResultState">@row.Result</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <nav class="live-pager" aria-label="Audit history pages">
                @if (Model.Page > 1)
                { <a class="live-button secondary" href="@ScreenUrls.Query("/admin/audit", new { q = Model.Query, page = Model.Page - 1 })" data-live-page>Previous</a> }
                <span>Page @Model.Page of @Model.PageCount</span>
                @if (Model.Page < Model.PageCount)
                { <a class="live-button secondary" href="@ScreenUrls.Query("/admin/audit", new { q = Model.Query, page = Model.Page + 1 })" data-live-page>Next</a> }
            </nav>
        }
        </div>
    </section>
</main>
