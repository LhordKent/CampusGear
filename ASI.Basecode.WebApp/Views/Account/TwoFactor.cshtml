@* TWO-FACTOR PAGE  (/auth/two-factor)  -  administrators type the code that was emailed to them.
   Shown by AccountController.TwoFactor (GET). *@
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = TitleText.AdministratorVerification;
}
<div class="auth-split">
    @await Html.PartialAsync("_AuthIntro", new AuthIntroModel
    {
        Eyebrow = "Administrator security / Step 2 of 2",
        Title = "Verify administrator",
        TitleAccent = "access",
        Lead = "Enter the 6-digit code sent to your email. Administrator controls stay locked until this step is complete.",
        StepsLabel = "Sign-in steps",
        Steps = new[] { "Password", "Verification code" },
        CurrentStep = 2
    })
    <section class="auth-card" aria-labelledby="auth-title">
        @await Html.PartialAsync("_AccountFeedback")
        @* Checks the code -> AccountController.TwoFactor (POST). *@
        <form class="auth-form" action="/auth/two-factor" method="post">
            @Html.AntiForgeryToken()
            <label class="auth-field" for="Code"><span class="auth-field-label">6-digit verification code</span>
                <input class="auth-input auth-code" id="Code" name="Code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••" required />
                @Html.ValidationMessage("Code", null, new { @class = "auth-field-error" })
            </label>
            <button class="auth-action" type="submit">VERIFY AND CONTINUE</button>
        </form>
        <div class="auth-links">
            @* "Send a new code" -> AccountController.ResendTwoFactor. *@
            <form class="auth-inline-form" action="/auth/resend-two-factor" method="post">@Html.AntiForgeryToken()<button type="submit">Resend verification code</button></form>
            <a class="auth-link" href="/auth/login">Back to sign in</a>
        </div>
    </section>
</div>
