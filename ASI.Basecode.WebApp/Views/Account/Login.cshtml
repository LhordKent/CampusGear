@* LOGIN PAGE  (/auth/login)  -  shown by AccountController.Login (GET).
   Sending the form -> AccountController.Login (POST) -> AuthenticationService.LoginAsync. *@
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = TitleText.SignIn;
}
<div class="auth-split">
    @await Html.PartialAsync("_AuthIntro", new AuthIntroModel
    {
        Eyebrow = Account.SignInEyebrow,
        Title = Account.SignInHeadline,
        TitleAccent = Account.SignInHeadlineBrand,
        Lead = Account.SignInLead,
        StepsLabel = Account.SystemScope,
        Scope = Account.SystemScopeSteps
    })
    <section class="auth-card" aria-labelledby="auth-title">
        @await Html.PartialAsync("_AccountFeedback")
        @* Email + password. Administrators are sent to the two-factor page next; everyone else goes to their dashboard. *@
        <form class="auth-form" action="/auth/login" method="post">
            @Html.AntiForgeryToken()
            <label class="auth-field" for="Email">
                <span class="auth-field-label">@Account.CampusEmail</span>
                <span class="auth-input-wrap">
                    <img class="auth-input-icon" src="/img/afa76.svg" alt="" />
                    <input class="auth-input has-icon" id="Email" name="Email" type="email" value="@(ViewData["Email"] as string)" placeholder="@Account.EmailPlaceholder" autocomplete="username" required />
                </span>
                @Html.ValidationMessage("Email", null, new { @class = "auth-field-error" })
            </label>
            <div class="auth-field">
                <div class="auth-field-head">
                    <label class="auth-field-label" for="Password">@Account.Password</label>
                    <a class="auth-link" href="/auth/password-reset-request">@Account.ForgotPassword</a>
                </div>
                <span class="auth-input-wrap">
                    <img class="auth-input-icon" src="/img/5e774.svg" alt="" />
                    <input class="auth-input has-icon has-reveal" id="Password" name="Password" type="password" placeholder="@Account.PasswordPlaceholder" autocomplete="current-password" required />
                    @await Html.PartialAsync("_PasswordReveal", "Password")
                </span>
                @Html.ValidationMessage("Password", null, new { @class = "auth-field-error" })
            </div>
            <button class="auth-action" type="submit">@Button.SignIn</button>
        </form>
        <p class="auth-switch">@Account.NewHere <a class="auth-link" href="/auth/signup">@Account.CreateAccountLink</a></p>
    </section>
</div>
