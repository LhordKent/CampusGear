@* ACCESS DENIED PAGE  -  shown when a signed-in user opens a page their role isn't allowed to see. *@
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = TitleText.AccessDenied;
}
<div class="auth-split">
    @await Html.PartialAsync("_AuthIntro", new AuthIntroModel
    {
        Eyebrow = "Authorization / Access restricted",
        Title = "Access",
        TitleAccent = "denied",
        Lead = "Your role can’t open this page. Ask an administrator to review your role if you need access."
    })
    <section class="auth-card" aria-labelledby="auth-title">
        <div class="auth-summary">
            <strong>Workspace permission required</strong>
            <p>This page is outside your account’s assigned role. No access rights are changed from this screen.</p>
        </div>
        <a class="auth-action" href="/auth/login">GO TO MY WORKSPACE</a>
    </section>
</div>
