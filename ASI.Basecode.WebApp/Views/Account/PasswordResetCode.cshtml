@* FORGOT PASSWORD - STEP 2  (/auth/password-reset-code)  -  the user types the emailed code. *@
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = TitleText.EnterResetCode;
}
<div class="auth-split">
    @await Html.PartialAsync("_AuthIntro", new AuthIntroModel
    {
        Eyebrow = "Account recovery / Step 2 of 3",
        Title = "Enter your",
        TitleAccent = "reset code",
        Lead = "We sent a 6-digit code to your email. If you requested more than one, use the newest code.",
        StepsLabel = "Recovery steps",
        Steps = new[] { "Verify account", "Verify code", "Set new password" },
        CurrentStep = 2
    })
    <section class="auth-card" aria-labelledby="auth-title">
        @await Html.PartialAsync("_AccountFeedback")
        @* Checks the code -> PasswordResetController.PasswordResetCode (POST). *@
        <form class="auth-form" action="/auth/password-reset-code" method="post">
            @Html.AntiForgeryToken()
            <label class="auth-field" for="Code"><span class="auth-field-label">Reset code</span>
                <input class="auth-input auth-code" id="Code" name="Code" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" placeholder="••••••" required />
                @Html.ValidationMessage("Code", null, new { @class = "auth-field-error" })
            </label>
            <button class="auth-action" type="submit">VERIFY CODE</button>
        </form>
        <div class="auth-links">
            @* "Send a new code" -> PasswordResetController.ResendPasswordResetCode. *@
            <form class="auth-inline-form" action="/auth/resend-password-reset-code" method="post">@Html.AntiForgeryToken()<button type="submit">Resend code</button></form>
            <a class="auth-link" href="/auth/password-reset-request">Use a different email address</a>
        </div>
    </section>
</div>
