@{
    Layout = "_AccountLayout";
    ViewData["Title"] = TitleText.ResetPassword;
}
<div class="auth-split">
    @await Html.PartialAsync("_AuthIntro", new AuthIntroModel
    {
        Eyebrow = "Account recovery / Step 1 of 3",
        Title = "Reset your",
        TitleAccent = "password",
        Lead = "Enter your account email and we'll send you a reset code.",
        StepsLabel = "Recovery steps",
        Steps = new[] { "Verify account", "Verify code", "Set new password" },
        CurrentStep = 1
    })
    <section class="auth-card" aria-labelledby="auth-title">
        @await Html.PartialAsync("_AccountFeedback")
        <form class="auth-form" action="/auth/password-reset-request" method="post">
            @Html.AntiForgeryToken()
            <label class="auth-field" for="Email"><span class="auth-field-label">Email address</span>
                <input class="auth-input" id="Email" name="Email" type="email" value="@(ViewData["Email"] as string)" placeholder="name@example.com" autocomplete="email" required />
                @Html.ValidationMessage("Email", null, new { @class = "auth-field-error" })
            </label>
            <button class="auth-action" type="submit">SEND RESET CODE</button>
        </form>
        <p class="auth-switch">Remembered it? <a class="auth-link" href="/auth/login">Back to sign in</a></p>
    </section>
</div>
