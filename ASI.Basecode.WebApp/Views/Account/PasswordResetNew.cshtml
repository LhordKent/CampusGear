@{
    Layout = "_AccountLayout";
    ViewData["Title"] = TitleText.SetNewPassword;
}
<div class="auth-split">
    @await Html.PartialAsync("_AuthIntro", new AuthIntroModel
    {
        Eyebrow = "Account recovery / Step 3 of 3",
        Title = "Set your",
        TitleAccent = "new password",
        Lead = "Choose a new password, then sign in with it.",
        StepsLabel = "Recovery steps",
        Steps = new[] { "Verify account", "Verify code", "Set new password" },
        CurrentStep = 3
    })
    <section class="auth-card" aria-labelledby="auth-title">
        @await Html.PartialAsync("_AccountFeedback")
        <form class="auth-form" action="/auth/password-reset-new" method="post">
            @Html.AntiForgeryToken()
            <label class="auth-field" for="Password"><span class="auth-field-label">New password</span>
                <span class="auth-input-wrap">
                    <input class="auth-input has-reveal" id="Password" name="Password" type="password" placeholder="Enter a new password" autocomplete="new-password" minlength="8" required aria-describedby="password-help" />
                    @await Html.PartialAsync("_PasswordReveal", "Password")
                </span>
                @Html.ValidationMessage("Password", null, new { @class = "auth-field-error" })
            </label>
            <label class="auth-field" for="ConfirmPassword"><span class="auth-field-label">Confirm password</span>
                <span class="auth-input-wrap">
                    <input class="auth-input has-reveal" id="ConfirmPassword" name="ConfirmPassword" type="password" placeholder="Repeat your new password" autocomplete="new-password" minlength="8" required />
                    @await Html.PartialAsync("_PasswordReveal", "ConfirmPassword")
                </span>
                @Html.ValidationMessage("ConfirmPassword", null, new { @class = "auth-field-error" })
            </label>
            <partial name="_PasswordRules" model='new PasswordRulesModel("Password", "ConfirmPassword")' />
            <button class="auth-action" type="submit">UPDATE PASSWORD</button>
        </form>
    </section>
</div>
