@* MAINTENANCE PAGE  (/admin/maintenance)  -  repair cases. Shown by MaintenanceController.Index.
   While a case is open, its item is on hold and can't be booked. *@
@using ASI.Basecode.Services.Manager
@using ASI.Basecode.WebApp.Models
@using ASI.Basecode.Resources.Constants
@using ASI.Basecode.Services.ServiceModels
@model MaintenancePageModel
@{
    ViewData["Title"] = TitleText.EquipmentMaintenance;
    var closed = Model.Status == "closed";
    var available = Model.Items.Count(x => x.Blocked is null);
    string Label(MaintenanceStatus status) => status switch
    {
        MaintenanceStatus.InProgress => "In progress",
        _ => status.ToString()
    };
    string Url(object values) => ScreenUrls.Query("/admin/maintenance", values);
}
<main class="live-content maintenance-page">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">Inventory</p>
            <h1>Equipment Maintenance</h1>
            <p class="page-description">Repairs and condition holds. Equipment in maintenance can't be reserved or released until its case is closed.</p>
        </div>
        <div class="page-header-actions">
            @if (User.IsInRole("Administrator")) { <a class="live-button secondary" href="/admin/equipment">Back to equipment</a> }
            <button class="live-button live-button-strong" type="button" data-modal-open="open-maintenance"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#wrench"></use></svg>Open maintenance</button>
        </div>
    </header>
    @if (Model.Feedback is not null) { <div class="live-feedback @(Model.Tone == "error" ? "error" : "")" role="status" data-toast="@Model.Tone">@Model.Feedback</div> }

    <section class="live-panel" aria-labelledby="maintenance-title">
        <div class="custodian-panel-heading">
            <h2 id="maintenance-title">Maintenance cases</h2>
            <nav id="maintenance-tabs" class="segmented" aria-label="Case status" data-refresh-region>
                <a class="@(closed ? "" : "is-selected")" href="/admin/maintenance" aria-current="@(closed ? null : "page")">Open <span class="live-count">@Model.OpenTotal</span></a>
                <a class="@(closed ? "is-selected" : "")" href="/admin/maintenance?status=closed" aria-current="@(closed ? "page" : null)">Closed <span class="live-count">@Model.ClosedTotal</span></a>
            </nav>
        </div>
        @* Status filter + search. *@
        <form class="live-filters" method="get" action="/admin/maintenance" role="search" aria-label="Find maintenance cases" data-live-search data-live-target="#maintenance-results">
            @if (closed) { <input type="hidden" name="status" value="closed" /> }
            <label for="maintenance-q" class="live-filter-search">Search cases<span class="live-search-input"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search"></use></svg><input id="maintenance-q" name="q" type="search" value="@Model.Query" maxlength="120" placeholder="Equipment, asset code, issue, or repair notes" autocomplete="off" /></span></label>
            <a class="live-button secondary live-filter-reset" href="/admin/maintenance@(closed ? "?status=closed" : "")" data-live-reset>Clear</a>
        </form>

        <div id="maintenance-results" class="live-results" data-refresh-region>
            <p class="live-result-count" data-live-count>@Model.Total @(closed ? "closed" : "open") case@(Model.Total == 1 ? "" : "s")@(string.IsNullOrEmpty(Model.Query) ? "" : $" matching “{Model.Query}”") · newest first</p>
            @if (Model.Cases.Count == 0)
            {
                <div class="live-empty">
                    <svg class="icon" aria-hidden="true"><use href="/img/icons.svg#@(string.IsNullOrEmpty(Model.Query) ? "wrench" : "search")"></use></svg>
                    @if (!string.IsNullOrEmpty(Model.Query))
                    { <h3>No matching cases</h3><p>Try another equipment name, asset code, or issue.</p> }
                    else if (closed)
                    { <h3>No closed cases yet</h3><p>Cases appear here once a repair is recorded.</p> }
                    else
                    { <h3>No equipment is in maintenance</h3><p>Use <strong>Open maintenance</strong> when an item needs repair or inspection.</p> }
                </div>
            }
            else
            {
                <div class="live-table-wrap" tabindex="0" role="region" aria-label="Maintenance cases">
                    <table class="live-table maintenance-table">
                        <thead><tr><th scope="col">Equipment</th><th scope="col">Issue</th><th scope="col">Status</th><th scope="col">@(closed ? "Closed" : "Opened")</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Cases)
                        {
                            var dialogId = $"case-{item.Id:N}";
                            <tr>
                                <td><strong>@item.EquipmentItem.Name</strong><small>@item.EquipmentItem.AssetCode</small></td>
                                <td class="maintenance-issue"><span class="line-clamp">@item.Description</span>@if (closed && item.Resolution is not null) { <small class="line-clamp">Repair: @item.Resolution</small> }</td>
                                <td><span class="live-badge" data-state="@(item.Status == MaintenanceStatus.Closed ? "closed" : item.Status == MaintenanceStatus.InProgress ? "inprogress" : "maintenance")">@Label(item.Status)</span></td>
                                <td class="live-nowrap">@ManilaTime.Format(closed && item.ClosedAtUtc is { } closedAt ? closedAt : item.OpenedAtUtc)<small>by @((closed ? item.ClosedByUser?.FullName : item.OpenedByUser?.FullName) ?? "staff")</small></td>
                                <td class="live-table-action">
                                    <button class="live-button @(closed ? "secondary" : "")" type="button" data-modal-open="@dialogId">@(closed ? "View" : "Update")</button>
                                    <dialog id="@dialogId" class="live-modal" aria-labelledby="@dialogId-title">
                                        <div class="live-modal-head">
                                            <div><p class="page-eyebrow">@item.EquipmentItem.AssetCode</p><h2 id="@dialogId-title">@item.EquipmentItem.Name</h2></div>
                                            <button class="live-modal-close" type="button" data-modal-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#x"></use></svg></button>
                                        </div>
                                        <dl class="live-modal-facts">
                                            <div><dt>Status</dt><dd><span class="live-badge" data-state="@(item.Status == MaintenanceStatus.Closed ? "closed" : item.Status == MaintenanceStatus.InProgress ? "inprogress" : "maintenance")">@Label(item.Status)</span></dd></div>
                                            <div><dt>Opened</dt><dd>@ManilaTime.Format(item.OpenedAtUtc)<small>by @(item.OpenedByUser?.FullName ?? "staff")</small></dd></div>
                                            @if (item.ClosedAtUtc is { } closedOn) { <div><dt>Closed</dt><dd>@ManilaTime.Format(closedOn)<small>by @(item.ClosedByUser?.FullName ?? "staff")</small></dd></div> }
                                            <div class="wide"><dt>Reported issue</dt><dd class="custodian-preserve">@item.Description</dd></div>
                                            @if (item.Status == MaintenanceStatus.Closed) { <div class="wide"><dt>Repair notes</dt><dd class="custodian-preserve">@(item.Resolution ?? "—")</dd></div> }
                                        </dl>
                                        @if (item.Status == MaintenanceStatus.Closed)
                                        {
                                            <div class="live-modal-actions"><button class="live-button secondary" type="button" data-modal-close>Close</button></div>
                                        }
                                        else
                                        {
                                            @* UPDATE a case (status, notes; closing needs the repair details) -> MaintenanceController.Update. *@
                                            <form method="post" action="/admin/maintenance/@item.Id/update" class="live-form" data-modal-form novalidate>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(item.RowVersion)" />
                                                <div class="live-modal-alert wide" role="alert" data-modal-alert hidden></div>
                                                <label class="live-field"><span>Status</span>
                                                    <select name="Status" data-maintenance-status>
                                                        @foreach (var status in Enum.GetValues<MaintenanceStatus>()) { <option value="@status" selected="@(status == item.Status)">@(status == MaintenanceStatus.Closed ? "Closed · repair complete" : Label(status))</option> }
                                                    </select>
                                                </label>
                                                <label class="live-field"><span>Condition after repair</span>
                                                    <select name="Condition">@foreach (var condition in new[] { EquipmentCondition.Excellent, EquipmentCondition.Good, EquipmentCondition.Fair }) { <option value="@condition" selected="@(condition == EquipmentCondition.Good)">@condition</option> }</select>
                                                    <small class="live-help">Applied to the item when the case is closed.</small>
                                                </label>
                                                <label class="live-field wide"><span>Repair notes <small data-resolution-hint>Required to close the case</small></span>
                                                    <textarea name="Resolution" maxlength="2000" rows="4" placeholder="What was checked or repaired, parts replaced, who did the work">@item.Resolution</textarea>
                                                </label>
                                                <div class="live-modal-actions wide">
                                                    <button class="live-button secondary" type="button" data-modal-close>Cancel</button>
                                                    <button class="live-button" type="submit">Save maintenance</button>
                                                </div>
                                            </form>
                                        }
                                    </dialog>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.Pages > 1)
            {
                <nav class="live-pager" aria-label="Maintenance pages">
                    @if (Model.Page > 1) { <a class="live-button secondary" href="@Url(new { status = closed ? "closed" : null, q = Model.Query, page = Model.Page - 1 })" data-live-page>Previous</a> }
                    <span>Page @Model.Page of @Model.Pages</span>
                    @if (Model.Page < Model.Pages) { <a class="live-button secondary" href="@Url(new { status = closed ? "closed" : null, q = Model.Query, page = Model.Page + 1 })" data-live-page>Next</a> }
                </nav>
            }
        </div>
    </section>

    @* Open maintenance: step 1 picks a unit from a searchable list (damaged units first, unavailable ones last),
       step 2 describes the issue. wwwroot/js/maintenance-open.js filters, validates and keeps the footer summary. *@
    @{
        var choices = Model.Items
            .OrderByDescending(x => x.NeedsAttention)
            .ThenBy(x => x.Blocked is not null)
            .ThenBy(x => x.Name)
            .ThenBy(x => x.AssetCode)
            .ToList();
        var attention = choices.Count(x => x.NeedsAttention);
        string ConditionState(MaintenanceItemOption item) => item.Blocked is not null ? "blocked"
            : item.Condition switch
            {
                EquipmentCondition.Damaged => "bad",
                EquipmentCondition.Fair => "fair",
                _ => "good"
            };
    }
    <dialog id="open-maintenance" class="live-modal maint-open" aria-labelledby="open-maintenance-title" aria-describedby="open-maintenance-sub">
        <div class="live-modal-head">
            <div>
                <p class="page-eyebrow">New case</p>
                <h2 id="open-maintenance-title">Open maintenance</h2>
                <p class="maint-open-sub" id="open-maintenance-sub">The unit is held right away: no new reservations or releases until the case is closed.</p>
            </div>
            <button class="live-modal-close" type="button" data-modal-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#x"></use></svg></button>
        </div>
        @* OPEN a new case for an item -> MaintenanceController.Open (the item list is filtered by wwwroot/js/maintenance-open.js). *@
        <form method="post" action="/admin/maintenance/open" class="maint-open-form" data-modal-form data-maint-open novalidate>
            @Html.AntiForgeryToken()
            <div class="maint-open-body">
                <div class="live-modal-alert" role="alert" data-modal-alert hidden></div>

                <fieldset id="open-maintenance-item" class="maint-step" data-refresh-region>
                    <legend class="maint-step-title"><span class="maint-step-num" aria-hidden="true">1</span>Choose the equipment</legend>
                    <div class="maint-picker-tools">
                        <label class="live-search-input maint-picker-search">
                            <span class="visually-hidden">Search equipment</span>
                            <svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search"></use></svg>
                            <input type="search" placeholder="Search name, asset code, category or location" autocomplete="off" data-maint-search />
                        </label>
                        @if (attention > 0)
                        {
                            <div class="maint-chips" role="group" aria-label="Show">
                                <button type="button" class="maint-chip" aria-pressed="true" data-maint-filter="">All</button>
                                <button type="button" class="maint-chip" aria-pressed="false" data-maint-filter="attention"><i class="maint-dot" aria-hidden="true"></i>Needs attention <span>@attention</span></button>
                            </div>
                        }
                    </div>
                    <div class="maint-list" role="radiogroup" aria-label="Equipment" aria-describedby="maint-picker-note" data-maint-list>
                        @{ var shownBlockedHeading = false; }
                        @foreach (var item in choices)
                        {
                            var blocked = item.Blocked is not null;
                            if (blocked && !shownBlockedHeading)
                            {
                                shownBlockedHeading = true;
                                <p class="maint-group" data-maint-group>Can’t be placed in maintenance</p>
                            }
                            var location = string.IsNullOrWhiteSpace(item.Location) ? null : item.Location;
                            <label class="maint-option @(blocked ? "is-blocked" : "")" data-maint-option
                                   data-attention="@(item.NeedsAttention ? "true" : "false")"
                                   data-search="@($"{item.Name} {item.AssetCode} {item.Category} {location} {item.Condition}".ToLowerInvariant())"
                                   data-label="@item.Name · @item.AssetCode">
                                <input class="maint-option-input" type="radio" name="equipmentItemId" value="@item.Id" disabled="@blocked" />
                                <span class="maint-option-media" aria-hidden="true">
                                    @if (item.ImagePath is not null) { <img src="@item.ImagePath" alt="" loading="lazy" decoding="async" /> }
                                    else { <svg viewBox="0 0 24 24"><use href="#cg-icon-@EquipmentIcon.For(item.Name, item.Category)" /></svg> }
                                </span>
                                <span class="maint-option-text">
                                    <strong>@item.Name</strong>
                                    <small>@item.AssetCode · @item.Category@(location is null ? "" : $" · {location}")</small>
                                </span>
                                <span class="maint-badge" data-state="@ConditionState(item)">@(item.Blocked ?? item.Condition.ToString())</span>
                                <svg class="maint-option-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 12.5 4 4 8-9" /></svg>
                            </label>
                        }
                    </div>
                    <p class="maint-empty" data-maint-empty hidden>No equipment matches your search.</p>
                    <p class="maint-error" role="alert" data-maint-error="equipment" hidden>Choose the equipment that needs maintenance.</p>
                    <p class="maint-note" id="maint-picker-note">@available of @Model.Items.Count units can be placed in maintenance. Record an active loan’s return first.</p>
                </fieldset>

                <div class="maint-step">
                    <label class="maint-step-title" for="open-maintenance-description"><span class="maint-step-num" aria-hidden="true">2</span>Describe the issue</label>
                    <div class="maint-chips maint-starters" role="group" aria-label="Start with a common issue">
                        @foreach (var starter in new[] { "Won’t power on", "Physical damage", "Missing parts or accessories", "Not working properly", "Routine inspection" })
                        { <button type="button" class="maint-chip" data-maint-starter="@starter">@starter</button> }
                    </div>
                    <div class="live-field">
                        <textarea id="open-maintenance-description" name="description" required maxlength="2000" rows="4" aria-describedby="maint-description-hint" placeholder="What’s wrong, how it was found, and anything the repairer should know"></textarea>
                        <small class="maint-note" id="maint-description-hint">Staff see this on the case until it’s closed.</small>
                    </div>
                    <p class="maint-error" role="alert" data-maint-error="description" hidden>Describe the issue so the repairer knows what to check.</p>
                </div>
            </div>
            <div class="live-modal-actions maint-open-actions">
                <p class="maint-summary" data-maint-summary aria-live="polite">No equipment selected</p>
                <button class="live-button secondary" type="button" data-modal-close>Cancel</button>
                <button class="live-button" type="submit">Open maintenance case</button>
            </div>
        </form>
    </dialog>
    <partial name="~/Views/Borrower/_EquipmentIcons.cshtml" />
</main>
@section Styles { <link rel="stylesheet" href="~/css/maintenance.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/modal-forms.js" asp-append-version="true"></script>
    <script src="~/js/maintenance-open.js" asp-append-version="true"></script>
}
