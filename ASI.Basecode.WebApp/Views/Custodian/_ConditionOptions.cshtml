@using ASI.Basecode.Resources.Constants
@model ConditionOptionsModel
@* Condition picker as option buttons (radio inputs posted as "Condition"). Damaged and Unserviceable are marked as holds. *@
<fieldset class="live-field wide condition-options" disabled="@Model.Disabled">
    <legend>@Model.Legend</legend>
    <div class="condition-option-list">
        @foreach (var condition in Model.Options)
        {
            var hold = condition is EquipmentCondition.Damaged or EquipmentCondition.Unserviceable;
            <label class="condition-option @(hold ? "is-hold" : "")">
                <input type="radio" name="Condition" value="@condition" required checked="@(condition == Model.Selected)" />
                <span>@condition</span>
            </label>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Help)) { <small class="live-help">@Model.Help</small> }
</fieldset>
