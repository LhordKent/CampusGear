@model CustodianListViewModel
@{
    ViewData["Title"] = Model.Queue == "history" ? TitleText.BorrowingHistory : Model.Queue == "active" ? TitleText.ReturnDesk : TitleText.ReservationApprovals;
    var history = Model.Queue == "history";
    var returns = Model.Queue == "active";
    var staffPath = ViewData["WorkspaceRole"] as string == "Administrator" ? "/admin" : "/custodian";
    var basePath = staffPath + (returns ? "/returns" : history ? "/history" : "/approvals");
    var releaseTab = !history && !returns && Model.Status == "approved";
    var source =history ? "695:4595" : returns ? staffPath == "/admin" ? "695:3957" : "695:2032" : staffPath == "/admin" ? "695:3278" : "695:1499";
}
@section Styles { <link rel="stylesheet" href="~/css/custodian-workflows.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/modal-forms.js" asp-append-version="true"></script> }
<main class="live-content" data-figma-source="@source">
    <header class="page-header">
        <div class="page-header-text">
            <p class="page-eyebrow">@(history ? "Records" : "Equipment desk")</p>
            <h1>@(history ? "Borrowing History" : returns ? "Return & Condition Check" : "Approval & Release")</h1>
            <p class="page-description">@(history
                ? "Every reservation and loan, newest first. Filter by status or booking date to build a report."
                : returns ? "Check borrowed equipment back in and record its condition. The most recent loans are listed first."
                : "Review reservation requests before their hold expires. The newest requests are listed first.")</p>
        </div>
        <div class="page-header-actions">
            @if (history) { <a class="live-button secondary" href="@staffPath/calendar"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#calendar"></use></svg>Availability calendar</a> }
            else if (returns) { <a class="live-button secondary" href="@staffPath/approvals">Pending requests<span class="live-count">@Model.PendingCount</span></a> }
        </div>
    </header>
    @if (!history && !returns)
    {
        <nav class="custodian-tabs" aria-label="Approval queues" data-live-tabs="#queue-results" data-live-swap="#queue-title">
            <a href="@basePath" aria-current="@(releaseTab ? null : "page")">Pending requests<span class="live-count">@Model.PendingCount</span></a>
            <a href="@basePath?status=approved" aria-current="@(releaseTab ? "page" : null)">Pending release<span class="live-count">@Model.ApprovedCount</span></a>
        </nav>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Feedback)) { <div class="live-feedback" role="status" data-toast="success">@Model.Feedback</div> }
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="live-feedback error" role="alert" data-toast="error">@Model.Error</div> }
    <section class="live-panel" aria-labelledby="queue-title">
        <div class="custodian-panel-heading"><h2 id="queue-title">@(returns ? "Active loans awaiting return" : history ? "Reservation and loan records" : releaseTab ? "Approved bookings awaiting handoff" : "Requests awaiting a decision")</h2><span class="live-muted">Times in Manila (UTC+8)</span></div>
        <form class="live-filters" method="get" action="@basePath" role="search" aria-label="Filter records" data-live-search data-live-target="#queue-results">
            <label for="queue-search" class="live-filter-search">Search borrower or equipment<span class="live-search-input"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search"></use></svg><input id="queue-search" name="q" type="search" value="@Model.Search" maxlength="100" placeholder="Name, email, or asset code" autocomplete="off" /></span></label>
            @if (history)
            {
                <label for="queue-status">Status<select id="queue-status" name="status">
                    @foreach (var status in new[] { "all", "pending", "approved", "borrowed", "returned", "rejected", "cancelled", "expired", "late" })
                    { <option value="@status" selected="@(Model.Status == status)">@(char.ToUpperInvariant(status[0]) + status[1..])</option> }
                </select></label>
            }
            else if (!returns)
            {
                <input type="hidden" name="status" value="@(releaseTab ? "approved" : "pending")" />
            }
            <label for="queue-from">Booking from<input id="queue-from" name="from" type="date" value="@Model.From" /></label>
            <label for="queue-to">Booking through<input id="queue-to" name="to" type="date" value="@Model.To" /></label>
            <a class="live-button secondary live-filter-reset" href="@(releaseTab ? basePath + "?status=approved" : basePath)" data-live-reset>Reset</a>
        </form>
        <div id="queue-results" class="live-results" data-refresh-region>
        <p class="live-result-count" data-live-count>@Model.Total record@(Model.Total == 1 ? "" : "s")@(string.IsNullOrWhiteSpace(Model.Search) ? "" : $" matching “{Model.Search}”")</p>
        @if (Model.Rows.Count == 0)
        {
            <div class="live-empty"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#search"></use></svg><h3>No matching records</h3><p>Try another search term, status, or date range.</p></div>
        }
        else
        {
            <div class="live-table-wrap" tabindex="0" role="region" aria-label="Reservation records; scroll horizontally on small screens">
                <table class="live-table custodian-table"><caption class="custodian-sr-only">@(ViewData["Title"]) records</caption><thead><tr><th scope="col">Borrower</th><th scope="col">Equipment</th><th scope="col">Booking time</th><th scope="col">Status</th>@if (history) { <th scope="col">Return</th> }<th scope="col">Action</th></tr></thead>
                    <tbody>@foreach (var row in Model.Rows)
                    {
                        <tr><td><strong>@row.BorrowerName</strong><small>@row.BorrowerEmail</small></td><td>@row.EquipmentName<small>@row.AssetCode</small></td><td>@row.StartManila<small>Until @row.EndManila</small></td><td><span class="live-badge custodian-status @(row.Status is "Overdue" or "Returned late" ? "late" : "")">@row.Status</span></td>
                            @if (history) { <td>@(row.ReturnCondition ?? "—")<small>@row.ReturnedManila</small></td> }
                            @if (returns && staffPath == "/custodian")
                            {
                                var dialogId = $"return-{row.Id:N}";
                                var early = row.Status == "Borrowed";
                                <td class="custodian-row-actions">
                                    <button class="live-button" type="button" data-modal-open="@dialogId">@(early ? "Record early return" : "Record return")</button>                                    <dialog id="@dialogId" class="live-modal return-dialog" aria-labelledby="@dialogId-title">
                                        <div class="live-modal-head">
                                            <div><p class="page-eyebrow">@row.AssetCode</p><h2 id="@dialogId-title">@(early ? "Record early return" : "Record return")</h2></div>
                                            <button class="live-modal-close" type="button" data-modal-close aria-label="Close"><svg class="icon" aria-hidden="true"><use href="/img/icons.svg#x"></use></svg></button>
                                        </div>
                                        @{
                                            var initials = string.Concat(row.BorrowerName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
                                        }
                                        <article class="borrowing-id-card is-compact" aria-label="CampusGear Borrowing ID">
                                            <header class="borrowing-id-masthead">
                                                <div class="borrowing-id-brand">
                                                    <img src="/img/b95f3.svg" alt="" />
                                                    <div><strong>CampusGear</strong><span>BORROWING ID</span></div>
                                                </div>
                                                <div class="borrowing-id-number">
                                                    <span>RESERVATION ID</span>
                                                    <strong>RES-@row.Id.ToString("N").ToUpperInvariant()</strong>
                                                    <span class="live-badge custodian-status @(row.Status is "Overdue" ? "late" : "")">@row.Status</span>
                                                </div>
                                            </header>
                                            <div class="borrowing-id-compact-body">
                                                <div class="borrowing-id-compact-person">
                                                    <div class="borrowing-id-avatar" aria-hidden="true">@initials</div>
                                                    <div>
                                                        <span class="borrowing-id-label">AUTHORIZED BORROWER</span>
                                                        <strong>@row.BorrowerName</strong>
                                                        <small>@row.BorrowerEmail</small>
                                                    </div>
                                                </div>
                                                <div class="borrowing-id-compact-item">
                                                    <span class="borrowing-id-label">EQUIPMENT ON LOAN</span>
                                                    <strong>@row.EquipmentName</strong>
                                                    <small>Asset @row.AssetCode</small>
                                                </div>
                                            </div>
                                            <div class="borrowing-id-dates">
                                                <div><span>BORROWED</span><strong>@row.StartManila</strong></div>
                                                <div><span>EXPECTED RETURN</span><strong class="@(row.Status is "Overdue" ? "is-late" : "")">@row.EndManila</strong></div>
                                            </div>
                                        </article>
                                        @if (early)
                                        {
                                            <p class="live-feedback" role="note">Returning before the due time. The item becomes available for the rest of the booking.</p>
                                        }
                                        <form method="post" action="/custodian/reservations/@row.Id/return" class="live-form" data-modal-form novalidate>
                                            @Html.AntiForgeryToken()
                                            <div class="live-modal-alert wide" role="alert" data-modal-alert hidden></div>
                                            <fieldset class="live-field wide condition-options">
                                                <legend>Condition at return</legend>
                                                <div class="condition-option-list">
                                                    @foreach (var condition in Enum.GetValues<ASI.Basecode.Resources.Constants.EquipmentCondition>())
                                                    {
                                                        var hold = condition is ASI.Basecode.Resources.Constants.EquipmentCondition.Damaged or ASI.Basecode.Resources.Constants.EquipmentCondition.Unserviceable;
                                                        <label class="condition-option @(hold ? "is-hold" : "")">
                                                            <input type="radio" name="Condition" value="@condition" required checked="@(condition == ASI.Basecode.Resources.Constants.EquipmentCondition.Good)" />
                                                            <span>@condition</span>
                                                        </label>
                                                    }
                                                </div>
                                                <small class="live-help">Damaged or Unserviceable puts the item on a maintenance hold.</small>
                                            </fieldset>
                                            <label class="live-field wide"><span>Damage or inspection notes <small>Optional</small></span>
                                                <textarea name="Notes" rows="3" maxlength="2000" placeholder="Describe damage, missing parts, or other inspection findings"></textarea>
                                            </label>
                                            <div class="live-modal-actions wide">
                                                <button class="live-button secondary" type="button" data-modal-close>Cancel</button>
                                                <button class="live-button" type="submit">@(early ? "Record early return" : "Record return")</button>
                                            </div>
                                        </form>
                                    </dialog>
                                </td>
                            }
                            else
                            {
                                <td><a class="live-button secondary" href="/custodian/reservations/@row.Id">@(returns ? "View return" : "Review details")</a></td>
                            }
                            </tr>
                    }</tbody>
                </table>
            </div>
        }
        @if (Model.PageCount > 1) {
        <nav class="live-pager" aria-label="Record pages">
            @if (Model.Page > 1) { <a class="live-button secondary" href="@ScreenUrls.Query(basePath, new { q = Model.Search, status = Model.Status, from = Model.From, to = Model.To, queue = Model.Queue, page = Model.Page - 1 })" data-live-page>Previous</a> }
            <span>Page @Model.Page of @Model.PageCount</span>
            @if (Model.Page < Model.PageCount) { <a class="live-button secondary" href="@ScreenUrls.Query(basePath, new { q = Model.Search, status = Model.Status, from = Model.From, to = Model.To, queue = Model.Queue, page = Model.Page + 1 })" data-live-page>Next</a> }
        </nav>
        }
        </div>
    </section>
</main>
